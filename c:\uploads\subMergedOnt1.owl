                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000663"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000118>data set with assigned class labels</obo:IAO_0000118>
        <obo:IAO_0000117>PERSON: James Malone</obo:IAO_0000117>
        <obo:IAO_0000117>PERSON: Monnie McGee</obo:IAO_0000117>
        <obo:IAO_0000111>classified data set</obo:IAO_0000111>
        <obo:IAO_0000115 xml:lang="en">A data set that is produced as the output of a class prediction data transformation and consists of a data set with assigned class labels.</obo:IAO_0000115>
