<?xml version="1.0"?>
<rdf:RDF xmlns="file:/Users/maniumek/repos/llm-onto-merger/tests/scenarios/outputs/s6/cmt-edas/.comerger_ref/cluster1.owl#"
     xml:base="file:/Users/maniumek/repos/llm-onto-merger/tests/scenarios/outputs/s6/cmt-edas/.comerger_ref/cluster1.owl"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="file:/Users/maniumek/repos/llm-onto-merger/tests/scenarios/outputs/s6/cmt-edas/.comerger_ref/cluster1.owl"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://cmt#acceptPaper -->

    <owl:ObjectProperty rdf:about="http://cmt#acceptPaper">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#acceptedBy -->

    <owl:ObjectProperty rdf:about="http://cmt#acceptedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:range rdf:resource="http://cmt#Administrator"/>
        <owl:inverseOf rdf:resource="http://cmt#acceptPaper"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#addProgramCommitteeMember -->

    <owl:ObjectProperty rdf:about="http://cmt#addProgramCommitteeMember">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cmt#Administrator"/>
        <rdfs:range rdf:resource="http://cmt#ProgramCommitteeMember"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#addedBy -->

    <owl:ObjectProperty rdf:about="http://cmt#addedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://cmt#Administrator"/>
        <rdfs:domain rdf:resource="http://cmt#ProgramCommitteeMember"/>
        <owl:inverseOf rdf:resource="http://cmt#addProgramCommitteeMember"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#adjustBid -->

    <owl:ObjectProperty rdf:about="http://cmt#adjustBid">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://merged#Reviewer"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#adjustedBy -->

    <owl:ObjectProperty rdf:about="http://cmt#adjustedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <owl:inverseOf rdf:resource="http://cmt#adjustBid"/>
        <rdfs:range rdf:resource="http://merged#Reviewer"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#assignExternalReviewer -->

    <owl:ObjectProperty rdf:about="http://cmt#assignExternalReviewer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:range rdf:resource="http://cmt#ExternalReviewer"/>
        <owl:inverseOf rdf:resource="http://cmt#assignedByReviewer"/>
        <rdfs:domain rdf:resource="http://merged#Reviewer"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#assignReviewer -->

    <owl:ObjectProperty rdf:about="http://cmt#assignReviewer">
        <rdfs:domain rdf:resource="http://cmt#Administrator"/>
        <rdfs:range rdf:resource="http://merged#Reviewer"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#assignedByAdministrator -->

    <owl:ObjectProperty rdf:about="http://cmt#assignedByAdministrator">
        <rdfs:range rdf:resource="http://cmt#Administrator"/>
        <owl:inverseOf rdf:resource="http://cmt#assignReviewer"/>
        <rdfs:domain rdf:resource="http://merged#Reviewer"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#assignedByReviewer -->

    <owl:ObjectProperty rdf:about="http://cmt#assignedByReviewer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cmt#ExternalReviewer"/>
        <rdfs:range rdf:resource="http://merged#Reviewer"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#co-writePaper -->

    <owl:ObjectProperty rdf:about="http://cmt#co-writePaper">
        <rdfs:domain rdf:resource="http://cmt#Co-author"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#detailsEnteredBy -->

    <owl:ObjectProperty rdf:about="http://cmt#detailsEnteredBy">
        <rdfs:range rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#enableVirtualMeeting -->

    <owl:ObjectProperty rdf:about="http://cmt#enableVirtualMeeting">
        <rdfs:domain rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#endReview -->

    <owl:ObjectProperty rdf:about="http://cmt#endReview">
        <rdfs:domain rdf:resource="http://cmt#ProgramCommitteeChair"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#enterConferenceDetails -->

    <owl:ObjectProperty rdf:about="http://cmt#enterConferenceDetails">
        <rdfs:domain rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#enterReviewCriteria -->

    <owl:ObjectProperty rdf:about="http://cmt#enterReviewCriteria">
        <rdfs:domain rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#finalizePaperAssignment -->

    <owl:ObjectProperty rdf:about="http://cmt#finalizePaperAssignment">
        <rdfs:domain rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#hardcopyMailingManifestsPrintedBy -->

    <owl:ObjectProperty rdf:about="http://cmt#hardcopyMailingManifestsPrintedBy">
        <rdfs:range rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#hasCo-author -->

    <owl:ObjectProperty rdf:about="http://cmt#hasCo-author">
        <rdfs:range rdf:resource="http://cmt#Co-author"/>
        <owl:inverseOf rdf:resource="http://cmt#co-writePaper"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#hasConflictOfInterest -->

    <owl:ObjectProperty rdf:about="http://cmt#hasConflictOfInterest">
        <rdfs:domain rdf:resource="http://merged#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#hasProgramCommitteeMember -->

    <owl:ObjectProperty rdf:about="http://cmt#hasProgramCommitteeMember">
        <rdfs:range rdf:resource="http://cmt#ProgramCommitteeMember"/>
        <owl:inverseOf rdf:resource="http://cmt#memberOfProgramCommittee"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#markConflictOfInterest -->

    <owl:ObjectProperty rdf:about="http://cmt#markConflictOfInterest">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">In CMT terms, a ‘Conflict of Interest’ is an association between a specific Reviewer and a specific Paper that states there is a conflict of interest between that Reviewer and that paper. Conflicts can be marked by Authors (during paper submission) or by Reviewers (in Phase 2) or by Chairmen (in Phase 3).

Based on that conflict, the reviewer will not be able to bid on the paper, be assigned to that paper (either automatically by the system or manually by a Chairman) or view review submissions for that paper.
</rdfs:comment>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://cmt#Chairman"/>
                    <rdf:Description rdf:about="http://merged#Author"/>
                    <rdf:Description rdf:about="http://merged#Reviewer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://cmt#memberOfProgramCommittee -->

    <owl:ObjectProperty rdf:about="http://cmt#memberOfProgramCommittee">
        <rdfs:domain rdf:resource="http://cmt#ProgramCommitteeMember"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#paperAssignmentFinalizedBy -->

    <owl:ObjectProperty rdf:about="http://cmt#paperAssignmentFinalizedBy">
        <rdfs:range rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#paperAssignmentToolsRunBy -->

    <owl:ObjectProperty rdf:about="http://cmt#paperAssignmentToolsRunBy">
        <rdfs:range rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#printHardcopyMailingManifests -->

    <owl:ObjectProperty rdf:about="http://cmt#printHardcopyMailingManifests">
        <rdfs:domain rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#readByMeta-Reviewer -->

    <owl:ObjectProperty rdf:about="http://cmt#readByMeta-Reviewer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://cmt#Meta-Reviewer"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#readByReviewer -->

    <owl:ObjectProperty rdf:about="http://cmt#readByReviewer">
        <owl:inverseOf rdf:resource="http://cmt#readPaper"/>
        <rdfs:range rdf:resource="http://merged#Reviewer"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#readPaper -->

    <owl:ObjectProperty rdf:about="http://cmt#readPaper">
        <rdfs:domain rdf:resource="http://merged#Reviewer"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#rejectPaper -->

    <owl:ObjectProperty rdf:about="http://cmt#rejectPaper">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cmt#Administrator"/>
        <owl:inverseOf rdf:resource="http://cmt#rejectedBy"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#rejectedBy -->

    <owl:ObjectProperty rdf:about="http://cmt#rejectedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#reviewCriteriaEnteredBy -->

    <owl:ObjectProperty rdf:about="http://cmt#reviewCriteriaEnteredBy">
        <rdfs:range rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#reviewerBiddingStartedBy -->

    <owl:ObjectProperty rdf:about="http://cmt#reviewerBiddingStartedBy">
        <rdfs:range rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#runPaperAssignmentTools -->

    <owl:ObjectProperty rdf:about="http://cmt#runPaperAssignmentTools">
        <rdfs:domain rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#setMaxPapers -->

    <owl:ObjectProperty rdf:about="http://cmt#setMaxPapers">
        <rdfs:domain rdf:resource="http://cmt#Administrator"/>
        <rdfs:range rdf:resource="http://cmt#ProgramCommitteeMember"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#startReviewerBidding -->

    <owl:ObjectProperty rdf:about="http://cmt#startReviewerBidding">
        <rdfs:domain rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#submitPaper -->

    <owl:ObjectProperty rdf:about="http://cmt#submitPaper">
        <rdfs:domain rdf:resource="http://merged#Author"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#virtualMeetingEnabledBy -->

    <owl:ObjectProperty rdf:about="http://cmt#virtualMeetingEnabledBy">
        <rdfs:range rdf:resource="http://cmt#Administrator"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#writePaper -->

    <owl:ObjectProperty rdf:about="http://cmt#writePaper">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://merged#Author"/>
        <owl:inverseOf rdf:resource="http://merged#iswrittenby_hasauthor"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#writeReview -->

    <owl:ObjectProperty rdf:about="http://cmt#writeReview">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://merged#Reviewer"/>
    </owl:ObjectProperty>
    


    <!-- http://cmt#writtenBy -->

    <owl:ObjectProperty rdf:about="http://cmt#writtenBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <owl:inverseOf rdf:resource="http://cmt#writeReview"/>
        <rdfs:range rdf:resource="http://merged#Reviewer"/>
    </owl:ObjectProperty>
    


    <!-- http://edas#attendeeAt -->

    <owl:ObjectProperty rdf:about="http://edas#attendeeAt">
        <owl:inverseOf rdf:resource="http://edas#hasAttendee"/>
        <rdfs:domain rdf:resource="http://merged#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://edas#hasAttendee -->

    <owl:ObjectProperty rdf:about="http://edas#hasAttendee">
        <rdfs:range rdf:resource="http://merged#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://edas#hasRelatedDocument -->

    <owl:ObjectProperty rdf:about="http://edas#hasRelatedDocument"/>
    


    <!-- http://edas#hasRelatedPaper -->

    <owl:ObjectProperty rdf:about="http://edas#hasRelatedPaper">
        <rdfs:domain rdf:resource="http://merged#Author"/>
    </owl:ObjectProperty>
    


    <!-- http://edas#hasReviewHistory -->

    <owl:ObjectProperty rdf:about="http://edas#hasReviewHistory">
        <owl:inverseOf rdf:resource="http://edas#isReviewHistoryOf"/>
        <rdfs:domain rdf:resource="http://merged#Reviewer"/>
    </owl:ObjectProperty>
    


    <!-- http://edas#initiates -->

    <owl:ObjectProperty rdf:about="http://edas#initiates">
        <owl:inverseOf rdf:resource="http://edas#isInitiatedBy"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://edas#SessionChair"/>
                    <rdf:Description rdf:about="http://edas#TPCMember"/>
                    <rdf:Description rdf:about="http://merged#ConferenceChair"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://edas#isInitiatedBy -->

    <owl:ObjectProperty rdf:about="http://edas#isInitiatedBy">
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://edas#SessionChair"/>
                    <rdf:Description rdf:about="http://edas#TPCMember"/>
                    <rdf:Description rdf:about="http://merged#ConferenceChair"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://edas#isReviewHistoryOf -->

    <owl:ObjectProperty rdf:about="http://edas#isReviewHistoryOf">
        <rdfs:range rdf:resource="http://merged#Reviewer"/>
    </owl:ObjectProperty>
    


    <!-- http://merged#hasbeenassigned_isreviewing -->

    <owl:ObjectProperty rdf:about="http://merged#hasbeenassigned_isreviewing">
        <rdfs:domain rdf:resource="http://merged#Reviewer"/>
        <owl:inverseOf rdf:resource="http://merged#isreviewedby_assignedto"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://edas#SessionChair"/>
                    <rdf:Description rdf:about="http://edas#TPCMember"/>
                    <rdf:Description rdf:about="http://merged#ConferenceChair"/>
                    <rdf:Description rdf:about="http://merged#Reviewer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://merged#hasconferencemember_hasmember -->

    <owl:ObjectProperty rdf:about="http://merged#hasconferencemember_hasmember">
        <rdfs:range rdf:resource="http://cmt#ConferenceMember"/>
        <rdfs:range rdf:resource="http://merged#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://merged#isreviewedby_assignedto -->

    <owl:ObjectProperty rdf:about="http://merged#isreviewedby_assignedto">
        <rdfs:range rdf:resource="http://merged#Reviewer"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://edas#SessionChair"/>
                    <rdf:Description rdf:about="http://edas#TPCMember"/>
                    <rdf:Description rdf:about="http://merged#ConferenceChair"/>
                    <rdf:Description rdf:about="http://merged#Reviewer"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://merged#iswrittenby_hasauthor -->

    <owl:ObjectProperty rdf:about="http://merged#iswrittenby_hasauthor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <owl:inverseOf rdf:resource="http://edas#hasRelatedPaper"/>
        <rdfs:range rdf:resource="http://merged#Author"/>
    </owl:ObjectProperty>
    


    <!-- http://merged#memberofconference_ismemberof -->

    <owl:ObjectProperty rdf:about="http://merged#memberofconference_ismemberof">
        <rdfs:domain rdf:resource="http://cmt#ConferenceMember"/>
        <rdfs:domain rdf:resource="http://merged#Person"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://cmt#email -->

    <owl:DatatypeProperty rdf:about="http://cmt#email">
        <rdfs:domain rdf:resource="http://merged#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://cmt#maxPapers -->

    <owl:DatatypeProperty rdf:about="http://cmt#maxPapers">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://cmt#ProgramCommitteeMember"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://edas#hasBiography -->

    <owl:DatatypeProperty rdf:about="http://edas#hasBiography">
        <rdfs:domain rdf:resource="http://merged#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://edas#hasEmail -->

    <owl:DatatypeProperty rdf:about="http://edas#hasEmail">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://edas#hasFirstName -->

    <owl:DatatypeProperty rdf:about="http://edas#hasFirstName">
        <rdfs:domain rdf:resource="http://merged#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://edas#hasLastName -->

    <owl:DatatypeProperty rdf:about="http://edas#hasLastName">
        <rdfs:domain rdf:resource="http://merged#Person"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://cmt#Administrator -->

    <owl:Class rdf:about="http://cmt#Administrator">
        <rdfs:subClassOf rdf:resource="http://cmt#User"/>
    </owl:Class>
    


    <!-- http://cmt#AssociatedChair -->

    <owl:Class rdf:about="http://cmt#AssociatedChair">
        <rdfs:subClassOf rdf:resource="http://cmt#ConferenceMember"/>
        <owl:disjointWith rdf:resource="http://merged#ConferenceChair"/>
    </owl:Class>
    


    <!-- http://cmt#AuthorNotReviewer -->

    <owl:Class rdf:about="http://cmt#AuthorNotReviewer">
        <rdfs:subClassOf rdf:resource="http://merged#Author"/>
        <owl:disjointWith rdf:resource="http://cmt#ProgramCommitteeMember"/>
        <owl:disjointWith rdf:resource="http://merged#Reviewer"/>
    </owl:Class>
    


    <!-- http://cmt#Chairman -->

    <owl:Class rdf:about="http://cmt#Chairman">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://cmt#AssociatedChair"/>
                    <rdf:Description rdf:about="http://cmt#ProgramCommitteeChair"/>
                    <rdf:Description rdf:about="http://merged#ConferenceChair"/>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://merged#Person"/>
    </owl:Class>
    


    <!-- http://cmt#Co-author -->

    <owl:Class rdf:about="http://cmt#Co-author">
        <rdfs:subClassOf rdf:resource="http://merged#Author"/>
    </owl:Class>
    


    <!-- http://cmt#ConferenceMember -->

    <owl:Class rdf:about="http://cmt#ConferenceMember">
        <rdfs:subClassOf rdf:resource="http://merged#Person"/>
    </owl:Class>
    


    <!-- http://cmt#ExternalReviewer -->

    <owl:Class rdf:about="http://cmt#ExternalReviewer">
        <rdfs:subClassOf rdf:resource="http://merged#Person"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://cmt#assignedByReviewer"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://merged#Reviewer"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An External Reviewer is a person that has been assigned to review a paper for another Reviewer, but is not themselves a Reviewer. </rdfs:comment>
    </owl:Class>
    


    <!-- http://cmt#Meta-Reviewer -->

    <owl:Class rdf:about="http://cmt#Meta-Reviewer">
        <rdfs:subClassOf rdf:resource="http://merged#Reviewer"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A special type of Reviewer.  There can be any number of Reviewers for a given paper, but only one Meta-Reviewer.  The Meta-Reviewer can go over all the reviews submitted for the paper and submit their own review.  Questions for the Meta-Reviewer can be different from those for a normal Reviewer.  Their role is to ensure that the reviews are good and consistent. The decision to use Meta-Reviewers is optional, and must be set before paper assignment occurs.</rdfs:comment>
    </owl:Class>
    


    <!-- http://cmt#ProgramCommitteeChair -->

    <owl:Class rdf:about="http://cmt#ProgramCommitteeChair">
        <rdfs:subClassOf rdf:resource="http://cmt#ProgramCommitteeMember"/>
    </owl:Class>
    


    <!-- http://cmt#ProgramCommitteeMember -->

    <owl:Class rdf:about="http://cmt#ProgramCommitteeMember">
        <rdfs:subClassOf rdf:resource="http://cmt#ConferenceMember"/>
        <rdfs:subClassOf rdf:resource="http://merged#Person"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The Program Committee consists of all members of the conference except for Authors who are not also Reviewers.</rdfs:comment>
    </owl:Class>
    


    <!-- http://cmt#User -->

    <owl:Class rdf:about="http://cmt#User">
        <rdfs:subClassOf rdf:resource="http://merged#Person"/>
    </owl:Class>
    


    <!-- http://edas#Attendee -->

    <owl:Class rdf:about="http://edas#Attendee">
        <rdfs:subClassOf rdf:resource="http://merged#Person"/>
    </owl:Class>
    


    <!-- http://edas#Presenter -->

    <owl:Class rdf:about="http://edas#Presenter">
        <rdfs:subClassOf rdf:resource="http://merged#Author"/>
    </owl:Class>
    


    <!-- http://edas#SessionChair -->

    <owl:Class rdf:about="http://edas#SessionChair">
        <rdfs:subClassOf rdf:resource="http://merged#Person"/>
        <owl:disjointWith rdf:resource="http://merged#Author"/>
    </owl:Class>
    


    <!-- http://edas#TPCMember -->

    <owl:Class rdf:about="http://edas#TPCMember">
        <rdfs:subClassOf rdf:resource="http://merged#Person"/>
        <owl:disjointWith rdf:resource="http://merged#Author"/>
    </owl:Class>
    


    <!-- http://merged#Author -->

    <owl:Class rdf:about="http://merged#Author">
        <owl:equivalentClass>
            <owl:Class>
