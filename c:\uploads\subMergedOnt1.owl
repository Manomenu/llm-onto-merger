                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0200175"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115 xml:lang="en">A data set that is produced as the output of a class discovery data transformation and consists of a data set with assigned discovered class labels.</obo:IAO_0000115>
        <obo:IAO_0000232>AR thinks could be a data item instead</obo:IAO_0000232>
        <obo:IAO_0000118>data set with assigned discovered class labels</obo:IAO_0000118>
        <obo:IAO_0000117>PERSON: James Malone</obo:IAO_0000117>
        <obo:IAO_0000117>PERSON: Monnie McGee</obo:IAO_0000117>
        <obo:IAO_0000111>clustered data set</obo:IAO_0000111>
