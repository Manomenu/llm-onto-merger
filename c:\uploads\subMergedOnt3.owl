        <rdfs:subClassOf rdf:resource="https://w3id.org/iot/qoi#Quality"/>
        <rdfs:comment xml:lang="en">Describes the agreement between information provided by the monitored data source and information provided by other independent data sources providing correlating effects.</rdfs:comment>
