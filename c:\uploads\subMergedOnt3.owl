        <rdfs:subClassOf rdf:resource="https://w3id.org/iot/qoi#Quality"/>
        <rdfs:comment xml:lang="en">Defines if data provided by a data sources makes sense regarding all the probabilistic knowledge about the data source. E.g. for a temperature sensore the temperature is within a certain value range.</rdfs:comment>
        <ns:term_status xml:lang="en">stable</ns:term_status>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/iot/qoi"/>
    </owl:Class>
    


