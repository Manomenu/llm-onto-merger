    <owl:Ontology rdf:about="http://purl.obolibrary.org/obo/mp.owl">
        <owl:versionIRI rdf:resource="http://purl.obolibrary.org/obo/mp/releases/2026-04-22/mp.owl"/>
        <obo:IAO_0000700 rdf:resource="http://purl.obolibrary.org/obo/MP_0000001"/>
        <dc:contributor>Alicia Valenzuela</dc:contributor>
        <dc:contributor>Anna Anagnostopolous</dc:contributor>
        <dc:contributor>Christopher Mungall</dc:contributor>
        <dc:contributor>Eisuke Dohi</dc:contributor>
        <dc:contributor>Georgios V. Gkoutos</dc:contributor>
        <dc:contributor>Hiroshi Masuya</dc:contributor>
        <dc:contributor>Howard Dene</dc:contributor>
