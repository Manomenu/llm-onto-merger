        <dc:contributor>Nicole Vasilevsky</dc:contributor>
        <dc:contributor>Paul Schofield</dc:contributor>
        <dc:contributor>Tatsuya Kushida</dc:contributor>
        <dc:contributor>Terue Takatsuki</dc:contributor>
        <dc:contributor>Toyofumi Fujiwara</dc:contributor>
        <dc:creator>Carroll W. Goldsmith</dc:creator>
