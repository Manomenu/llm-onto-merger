        <oboInOwl:hasRelatedSynonym>wasserloesliche Vitamine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>water-soluble vitamin</oboInOwl:hasRelatedSynonym>
