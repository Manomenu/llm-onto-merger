        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <obo:IAO_0000115>x adjacent to y if and only if x and y share a boundary.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>RO:0002220</oboInOwl:hasDbXref>
