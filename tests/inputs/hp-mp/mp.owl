                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76971"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A polydisperse, highly branched glucan composed of chains of &lt;small&gt;D&lt;/small&gt;-glucopyranose residues in α(1→4) glycosidic linkage, joined together by α(1→6) glycosidic linkages. A small number of α(1→3) glycosidic linkages and some cumulative α(1→6) links also may occur. The branches in glycogen typically contain 8 to 12 glucose residues.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:24379</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:5466</oboInOwl:hasAlternativeId>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Glycogen</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>animal starch</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>liver starch</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:28087</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>glycogen</rdfs:label>
    </owl:Class>
    <owl:Axiom>
