        <oboInOwl:hasRelatedSynonym>Liothyronine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>O-(4-hydroxy-3-iodophenyl)-3,5-diiodo-L-tyrosine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>T3</oboInOwl:hasRelatedSynonym>
