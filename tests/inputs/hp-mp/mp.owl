    <!-- http://purl.obolibrary.org/obo/CHEBI_28057 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28057">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_65212"/>
        <obo:IAO_0000115>A polydisperse highly branched polysaccharide derivative composed of chains of &lt;small&gt;D&lt;/small&gt;-glucopyranose residues in α(1→4) glycosidic linkage. The chains are joined together by α(1→6) glycosidic linkages. A small number of α(1→3) glycosidic linkages and some 6-phosphate ester groups also may occur. The branches in amylopectin typically contain 24 to 30 glucose residues.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:22538</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:2693</oboInOwl:hasAlternativeId>
        <oboInOwl:hasRelatedSynonym>Amylopectin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:28057</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>amylopectin</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28057"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Amylopectin</owl:annotatedTarget>
        <oboInOwl:hasDbXref>kegg.compound</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_28087 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
