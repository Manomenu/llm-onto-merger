    <!-- http://purl.obolibrary.org/obo/CHEBI_28102 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_28102">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37163"/>
