        <oboInOwl:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-09-26T01:08:58Z</oboInOwl:creation_date>
        <rdfs:label>results in changes to anatomical or cellular structure</rdfs:label>
    </owl:ObjectProperty>
    


