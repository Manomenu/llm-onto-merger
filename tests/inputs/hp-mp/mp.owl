            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_75771"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76924"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_76971"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A glucan composed of unbranched chains of &lt;small&gt;D&lt;/small&gt;-glucopyranose residues in α(1→4) glycosidic linkage. The number of repeated glucose subunits (n) is usually in the range of 300 to 3000, but can be many thousands. One of the two components of starch (the other, 70-80%, being amylopectin). Cf. linear maltodextrin, in which the chain length is typically between 3 and 17 glucose units.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>CHEBI:22539</oboInOwl:hasAlternativeId>
        <oboInOwl:hasAlternativeId>CHEBI:2694</oboInOwl:hasAlternativeId>
        <oboInOwl:hasRelatedSynonym>(1,4-alpha-D-Glucosyl)n</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>(1,4-alpha-D-Glucosyl)n+1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>(1,4-alpha-D-Glucosyl)n-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>1,4-alpha-D-Glucan</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>4-{(1,4)-alpha-D-Glucosyl}(n-1)-D-glucose</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Amylose</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Amylose chain</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:28102</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi/3_STAR"/>
        <rdfs:label>amylose</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28102"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>(1,4-alpha-D-Glucosyl)n</owl:annotatedTarget>
        <oboInOwl:hasDbXref>kegg.compound</oboInOwl:hasDbXref>
    </owl:Axiom>
