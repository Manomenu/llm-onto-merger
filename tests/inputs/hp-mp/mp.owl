        <oboInOwl:hasRelatedSynonym>3,5,3'-Triiodo-L-thyronine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3,5,3'-Triiodothyronine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3,5,3'TRIIODOTHYRONINE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>4-(4-hydroxy-3-iodophenoxy)-3,5-diiodo-L-phenylalanine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>L-3,3',5-triiodothyronine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>L-3,5,3'-Triiodothyronine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>L-T3</oboInOwl:hasRelatedSynonym>
