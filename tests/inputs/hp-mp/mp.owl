    <!-- http://purl.obolibrary.org/obo/RO_0002220 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0002220">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002163"/>
