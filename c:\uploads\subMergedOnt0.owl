    </owl:ObjectProperty>
    


    <!-- http://ekaw#topicCoveredBy -->

    <owl:ObjectProperty rdf:about="http://ekaw#topicCoveredBy">
        <owl:inverseOf rdf:resource="http://ekaw#coversTopic"/>
