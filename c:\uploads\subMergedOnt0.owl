<?xml version="1.0"?>
<rdf:RDF xmlns="http://merged#"
     xml:base="http://merged"
     xmlns:schema="http://schema.org/"
     xmlns:iot-lite="http://purl.oclc.org/NET/UNIS/fiware/iot-lite#"
     xmlns:ns="http://www.w3.org/2003/06/sw-vocab-status/ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:wgs84_pos="http://www.w3.org/2003/01/geo/wgs84_pos#"
     xmlns:bibo="http://purl.org/ontology/bibo/"
     xmlns:vann="http://purl.org/vocab/vann#"
     xmlns:iot-stream="http://purl.org/iot/ontology/iot-stream#"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
    <owl:Ontology rdf:about="http://merged#">
        <owl:versionIRI rdf:resource="1.0"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.oclc.org/NET/UNIS/fiware/iot-lite#altRelative -->

    <owl:AnnotationProperty rdf:about="http://purl.oclc.org/NET/UNIS/fiware/iot-lite#altRelative">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#Point"/>
    </owl:AnnotationProperty>
    


    <!-- http://purl.oclc.org/NET/UNIS/fiware/iot-lite#relativeLocation -->

    <owl:AnnotationProperty rdf:about="http://purl.oclc.org/NET/UNIS/fiware/iot-lite#relativeLocation">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#Point"/>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/elements/1.1/Creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/Creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/Date -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/Date"/>
    


    <!-- http://purl.org/dc/elements/1.1/Title -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/Title"/>
    


    <!-- http://purl.org/dc/elements/1.1/abstract -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/abstract"/>
    


    <!-- http://purl.org/dc/elements/1.1/creator -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/creator"/>
    


    <!-- http://purl.org/dc/elements/1.1/description -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/description"/>
    


    <!-- http://purl.org/dc/elements/1.1/rights -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/rights"/>
    


    <!-- http://purl.org/dc/elements/1.1/source -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/elements/1.1/source"/>
    


    <!-- http://purl.org/dc/terms/bibliographicCitation -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/bibliographicCitation"/>
    


    <!-- http://purl.org/dc/terms/created -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/created"/>
    


    <!-- http://purl.org/dc/terms/modified -->

    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/modified"/>
    


    <!-- http://purl.org/iot/ontology/iot-stream#streamEnd -->

    <owl:AnnotationProperty rdf:about="http://purl.org/iot/ontology/iot-stream#streamEnd">
        <rdfs:domain rdf:resource="http://purl.org/iot/ontology/iot-stream#IotStream"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#streamStart -->

    <owl:AnnotationProperty rdf:about="http://purl.org/iot/ontology/iot-stream#streamStart">
        <rdfs:domain rdf:resource="http://purl.org/iot/ontology/iot-stream#IotStream"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/ontology/bibo/doi -->

    <owl:AnnotationProperty rdf:about="http://purl.org/ontology/bibo/doi"/>
    


    <!-- http://purl.org/ontology/bibo/status -->

    <owl:AnnotationProperty rdf:about="http://purl.org/ontology/bibo/status"/>
    


    <!-- http://purl.org/vocab/vann#preferredNamespaceUri -->

    <owl:AnnotationProperty rdf:about="http://purl.org/vocab/vann#preferredNamespaceUri"/>
    


    <!-- http://schema.org/contributor -->

    <owl:AnnotationProperty rdf:about="http://schema.org/contributor"/>
    


    <!-- http://schema.org/domainIncludes -->

    <owl:AnnotationProperty rdf:about="http://schema.org/domainIncludes"/>
    


    <!-- http://schema.org/rangeIncludes -->

    <owl:AnnotationProperty rdf:about="http://schema.org/rangeIncludes"/>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#alt -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#alt">
        <rdfs:label>altitude</rdfs:label>
        <rdfs:comment>The WGS84 altitude of a SpatialThing (decimal meters 
above the local reference ellipsoid).</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#Point"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#lat -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#lat">
        <rdfs:label>latitude</rdfs:label>
        <rdfs:comment>The WGS84 latitude of a SpatialThing (decimal degrees).</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#Point"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#long -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#long">
        <rdfs:label>longitude</rdfs:label>
        <rdfs:comment>The WGS84 longitude of a SpatialThing (decimal degrees).</rdfs:comment>
        <rdfs:domain rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#Point"/>
        <rdfs:domain rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.w3.org/2003/06/sw-vocab-status/ns#term_status -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2003/06/sw-vocab-status/ns#term_status"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#definition -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#definition"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#example -->

    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#example"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.oclc.org/NET/UNIS/fiware/iot-lite#hasQuantityKind -->

    <owl:ObjectProperty rdf:about="http://purl.oclc.org/NET/UNIS/fiware/iot-lite#hasQuantityKind">
        <rdfs:range rdf:resource="http://purl.oclc.org/NET/ssnx/qu/qu#QuantityKind"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.oclc.org/NET/UNIS/fiware/iot-lite#hasUnit -->

    <owl:ObjectProperty rdf:about="http://purl.oclc.org/NET/UNIS/fiware/iot-lite#hasUnit">
        <rdfs:range rdf:resource="http://purl.oclc.org/NET/ssnx/qu/qu#Unit"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#analysedBy -->

    <owl:ObjectProperty rdf:about="http://purl.org/iot/ontology/iot-stream#analysedBy">
        <rdfs:label xml:lang="en">analysed by</rdfs:label>
        <rdfs:range rdf:resource="http://purl.org/iot/ontology/iot-stream#Analytics"/>
        <rdfs:domain rdf:resource="http://purl.org/iot/ontology/iot-stream#IotStream"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#belongsTo -->

    <owl:ObjectProperty rdf:about="http://purl.org/iot/ontology/iot-stream#belongsTo">
        <rdfs:label xml:lang="en">belongs to</rdfs:label>
        <rdfs:range rdf:resource="http://purl.org/iot/ontology/iot-stream#IotStream"/>
        <rdfs:domain rdf:resource="http://purl.org/iot/ontology/iot-stream#StreamObservation"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#derivedFrom -->

    <owl:ObjectProperty rdf:about="http://purl.org/iot/ontology/iot-stream#derivedFrom">
        <rdfs:label xml:lang="en">derived from</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iot/ontology/iot-stream#IotStream"/>
        <rdfs:range rdf:resource="http://purl.org/iot/ontology/iot-stream#IotStream"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#detectedFrom -->

    <owl:ObjectProperty rdf:about="http://purl.org/iot/ontology/iot-stream#detectedFrom">
        <rdfs:label xml:lang="en">detected from</rdfs:label>
        <rdfs:domain rdf:resource="http://purl.org/iot/ontology/iot-stream#Event"/>
        <rdfs:range rdf:resource="http://purl.org/iot/ontology/iot-stream#IotStream"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#generatedBy -->

    <owl:ObjectProperty rdf:about="http://purl.org/iot/ontology/iot-stream#generatedBy">
        <rdfs:label xml:lang="en">generated by</rdfs:label>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/iot/ontology/iot-stream#Event"/>
                    <rdf:Description rdf:about="http://purl.org/iot/ontology/iot-stream#IotStream"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/iot/ontology/iot-stream#Analytics"/>
                    <rdf:Description rdf:about="http://www.w3.org/ns/sosa/Sensor"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#madeStreamObservation -->

    <owl:ObjectProperty rdf:about="http://purl.org/iot/ontology/iot-stream#madeStreamObservation">
        <rdfs:label xml:lang="en">made stream observation</rdfs:label>
        <rdfs:range rdf:resource="http://purl.org/iot/ontology/iot-stream#StreamObservation"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    </owl:ObjectProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#providedBy -->

    <owl:ObjectProperty rdf:about="http://purl.org/iot/ontology/iot-stream#providedBy">
        <rdfs:label xml:lang="en">provided by</rdfs:label>
        <rdfs:range rdf:resource="http://purl.oclc.org/NET/UNIS/fiware/iot-lite#Service"/>
        <rdfs:domain rdf:resource="http://purl.org/iot/ontology/iot-stream#IotStream"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf-vocabulary.ddialliance.org/xkos#generalizes -->

    <owl:ObjectProperty rdf:about="http://rdf-vocabulary.ddialliance.org/xkos#generalizes"/>
    


    <!-- http://rdf-vocabulary.ddialliance.org/xkos#hasPart -->

    <owl:ObjectProperty rdf:about="http://rdf-vocabulary.ddialliance.org/xkos#hasPart"/>
    


    <!-- http://rdf-vocabulary.ddialliance.org/xkos#isPartOf -->

    <owl:ObjectProperty rdf:about="http://rdf-vocabulary.ddialliance.org/xkos#isPartOf"/>
    


    <!-- http://rdf-vocabulary.ddialliance.org/xkos#next -->

    <owl:ObjectProperty rdf:about="http://rdf-vocabulary.ddialliance.org/xkos#next"/>
    


    <!-- http://rdf-vocabulary.ddialliance.org/xkos#previous -->

    <owl:ObjectProperty rdf:about="http://rdf-vocabulary.ddialliance.org/xkos#previous"/>
    


    <!-- http://rdf-vocabulary.ddialliance.org/xkos#specializes -->

    <owl:ObjectProperty rdf:about="http://rdf-vocabulary.ddialliance.org/xkos#specializes"/>
    


    <!-- http://rdf.webofcode.org/woc/constructs -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/constructs">
        <rdfs:label xml:lang="en">constructs</rdfs:label>
        <rdfs:comment xml:lang="en">The constructs property relates an executable to the classes it constructs.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Class"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Executable"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isConstructedBy"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/references"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/declares -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/declares">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">declares</rdfs:label>
        <rdfs:comment>The declares property relates a code element to the elements it declares. For instance, a class is linked to its fields, methods and constructors.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#hasPart"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isDeclaredBy"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/extends -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/extends">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">extends</rdfs:label>
        <rdfs:comment xml:lang="en">The extends property relates a class, an interface, a type variable or a wildacard to the types it extends.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#specializes"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/hasSubClass"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Class"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Interface"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/TypeVariable"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Wildcard"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasActualTypeArgument -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasActualTypeArgument">
        <rdfs:label xml:lang="en">has actual type argument</rdfs:label>
        <rdfs:comment>The hasActualTypeArgument property relates a parameterized type to each of its actual type arguments</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ParameterizedType"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/TypeArgument"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasAnnotation -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasAnnotation">
        <rdfs:label xml:lang="en">has annotation</rdfs:label>
        <rdfs:comment>The hasAnnotation property relates a code element to its annotations</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/AnnotationType"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isAnnotationOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasArgument -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasArgument">
        <rdfs:label xml:lang="en">has argument</rdfs:label>
        <rdfs:comment xml:lang="en">The hasArgument property relates an executable invocation to each of its actual arguments.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/ActualArgument"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ExecutableInvocationExpression"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasAssertExpression -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasAssertExpression">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has assert expression</rdfs:label>
        <rdfs:comment xml:lang="en">The hasAssertExpression property relates an assert statement to the boolean expression asserted to be true</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/AssertStatement"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isAssertExpressionOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasBody -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasBody">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has body</rdfs:label>
        <rdfs:comment xml:lang="en">The hasBody property relates an executable or a statement to its body.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/BlockStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubStatement"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isBodyOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Executable"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/LoopStatement"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/TryStatement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasCatchClause -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasCatchClause">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has catch clause</rdfs:label>
        <rdfs:comment xml:lang="en">The hasCatchClause property relates a try statement to the relative catch clauses.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/CatchBlock"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/TryStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubStatement"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isCatchClauseOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasCatchFormalParameter -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasCatchFormalParameter">
        <rdfs:label xml:lang="en">has catch formal parameter</rdfs:label>
        <rdfs:comment xml:lang="en">The hasCatchFormalParameter property relates a catch clause to its formal parameters, namely the throwable objects it caughts</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/CatchBlock"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Class"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasCondition -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasCondition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has condition</rdfs:label>
        <rdfs:comment xml:lang="en">The hasCondition property specifies a condition for a statement to be executed.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isConditionOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/DoStatement"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/ForStatement"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/IfThenElseStatement"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/WhileStatement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasConstructor -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasConstructor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has constructor</rdfs:label>
        <rdfs:comment xml:lang="en">The hasConstructor property relates a class to its constructors.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Constructor"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/declares"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isConstructorOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Class"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Enum"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasDeclaration -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasDeclaration">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">has declaration</rdfs:label>
        <rdfs:comment xml:lang="en">The hasDeclaration property relates a variable to the statement it was declared by.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Variable"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/VariableDeclarationStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasDependency -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasDependency">
        <rdfs:label xml:lang="en">has dependency</rdfs:label>
        <rdfs:comment xml:lang="en">The hasDependency property relates a project to its dependencies.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Library"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Project"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isDependencyOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasElseBranch -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasElseBranch">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has else branch</rdfs:label>
        <rdfs:comment xml:lang="en">The hasElseBranch property relates a if-then-else statement to the statement in the else branch.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/IfThenElseStatement"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubStatement"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isElseBranchOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasField -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasField">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has field</rdfs:label>
        <rdfs:comment xml:lang="en">The hasField property relates a class to its fields</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ComplexType"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Field"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/declares"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isFieldOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasFinallyClause -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasFinallyClause">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has finally clause</rdfs:label>
        <rdfs:comment xml:lang="en">The hasFinallyClause property relates a try statemet to its finally clause.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/FinallyBlock"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/TryStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubStatement"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isFinallyClauseOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasForInit -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasForInit">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has for init</rdfs:label>
        <rdfs:comment xml:lang="en">The hasForInit property relates a basic for statement to each statement expression executed as initialization code, before the first iteration step is performed</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ForStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isForInitOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasForUpdate -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasForUpdate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has for update</rdfs:label>
        <rdfs:comment xml:lang="en">The hasForUpdate property relates a basic for statement to each expression evaluated as update code at the end of every iteration</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ForStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isForUpdateOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasFormalTypeParameter -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasFormalTypeParameter">
        <rdfs:label xml:lang="en">has formal type parameter</rdfs:label>
        <rdfs:comment xml:lang="en">The hasFormalTypeParameter property relates a class, an interface, an enumeration, a constructor or a method to the formal type parameters it declares</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/TypeVariable"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Class"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Enum"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Executable"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Interface"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasGenericType -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasGenericType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">has generic type</rdfs:label>
        <rdfs:comment xml:lang="en">The hasGenericType property relates a parameterized type to the generic type it is a parameterization of</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ParameterizedType"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Class"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Interface"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/TypeVariable"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Wildcard"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasInitializer -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasInitializer">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has initializer</rdfs:label>
        <rdfs:comment xml:lang="en">The hasInitializer property relates a variable declaration to the expression assigned to the declared variable</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/VariableDeclarationStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isInitializerOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasLeftHandSide -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasLeftHandSide">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has left hand side</rdfs:label>
        <rdfs:comment xml:lang="en">The hasLeftHandSide property relates a assignement expression to the left hand side expression it contains</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/AssignmentExpression"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isLeftHandSideOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasMethod -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasMethod">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has method</rdfs:label>
        <rdfs:comment>The ihasMehtod property relates a class to its methods.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ComplexType"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Method"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/declares"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isMethodOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasModifier -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasModifier">
        <rdfs:label xml:lang="en">has modifier</rdfs:label>
        <rdfs:comment xml:lang="en">The hasGenericType property relates a modifiable element to its modifiers</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Modifiable"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Modifier"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isModifierOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasNextStatement -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasNextStatement">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">next</rdfs:label>
        <rdfs:comment xml:lang="en">The hasNextStatement property relates a statement to the next statement to be executed.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#next"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/hasPreviousStatement"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasPackage -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasPackage">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">has package</rdfs:label>
        <rdfs:comment xml:lang="en">The hasPackage property relates a class, interface, enum or annotation to the package it is declared by.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Package"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isDeclaredBy"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isPackageOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/AnnotationType"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/ComplexType"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasParameter -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasParameter">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has parameter</rdfs:label>
        <rdfs:comment xml:lang="en">The hasParameter property relates a constructor or a method to the formal parameters it declares</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Executable"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Parameter"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isParameterOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasPreviousStatement -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasPreviousStatement">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has previous statement</rdfs:label>
        <rdfs:comment xml:lang="en">The hasPreviousStatement property relates a statement to the previous one.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#previous"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasProject -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasProject">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">has project</rdfs:label>
        <rdfs:comment>The hasProject property relates a package to the project it belongs to.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#isPartOf"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Package"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Project"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isProjectOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasResource -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasResource">
        <rdfs:label xml:lang="en">has resource</rdfs:label>
        <rdfs:comment xml:lang="en">The hasResource property relates a try statement to each local variable declared to act as resource for the try statement</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/LocalVariable"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/TryStatement"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasReturnType -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasReturnType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">has return type</rdfs:label>
        <rdfs:comment xml:lang="en">The hasReturnType property relates a method to its return type.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Method"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Type"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasType"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isReturnTypeOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasReturnedExpression -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasReturnedExpression">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has returned expression</rdfs:label>
        <rdfs:comment xml:lang="en">The hasReturnedExpression property relates a return statement to the returned expression</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ReturnStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isReturnedExpressionOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasSubClass -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasSubClass">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has subclass</rdfs:label>
        <rdfs:comment xml:lang="en">The hasSubClass property relates a class to its direct sub-classes</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#generalizes"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Class"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Interface"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/TypeVariable"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Wildcard"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/AnnotationType"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/ComplexType"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasSubExpression -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasSubExpression">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has subexpression</rdfs:label>
        <rdfs:comment xml:lang="en">The hasSubExpression property relates a statement or expression to the expressions it contains.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#hasPart"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isSubExpressionOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Expression"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Statement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasSubProject -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasSubProject">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has subproject</rdfs:label>
        <rdfs:comment xml:lang="en">The hasSubProject property relates a project to its subprojects</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#hasPart"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Project"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Project"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isSubProjectOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasSubStatement -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasSubStatement">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has substatement</rdfs:label>
        <rdfs:comment xml:lang="en">The hasSubStatement property relates a statment to its sub-statements.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#hasPart"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isSubStatementOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Executable"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Statement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasSuperBound -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasSuperBound">
        <rdfs:label xml:lang="en">has super bound</rdfs:label>
        <rdfs:comment xml:lang="en">The hasSuperBound property relates a lower bounded wildcard to its bouds.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#generalizes"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Wildcard"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Class"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Interface"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/ParameterizedType"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/TypeVariable"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasSwitchLabel -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasSwitchLabel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has switch label</rdfs:label>
        <rdfs:comment xml:lang="en">The hasSwitchLabel property relates a switch statement to its cases.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/LabeledBlock"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/SwitchStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubStatement"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isSwitchLabelOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasTarget -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasTarget">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has target</rdfs:label>
        <rdfs:comment xml:lang="en">The hasTarget property relates a method invocation expression to its target.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/MethodInvocationExpression"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isTargetOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasThenBranch -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasThenBranch">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has then branch</rdfs:label>
        <rdfs:comment xml:lang="en">The hasThenBranch property relates a if-then-else statement to the statement declared in the &quot;then&quot; branch</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/IfThenElseStatement"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubStatement"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isThenBranchOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasThrownExpression -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasThrownExpression">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has thrown expression</rdfs:label>
        <rdfs:comment xml:lang="en">The hasThrownExpression property relates a thrown statement to the expression it throws</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ThrowStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isThrownExpressionOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasType -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">has type</rdfs:label>
        <rdfs:comment xml:lang="en">The hasType property relates an expression, a variable or a method to its type.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Type"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isTypeOf"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Expression"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Method"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Variable"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasVariable -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/hasVariable">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">has variable</rdfs:label>
        <rdfs:comment xml:lang="en">The hasVariable property relates a for-each statement to the local variable it declares.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ForEachStatement"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/LocalVariable"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/implements -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/implements">
        <rdfs:label xml:lang="en">implements</rdfs:label>
        <rdfs:comment xml:lang="en">The implements property relates a class to each implemented interface.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#specializes"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Class"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Interface"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/isImplementedBy"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/invokes -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/invokes">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">invokes</rdfs:label>
        <rdfs:comment xml:lang="en">The invokes property relates a invocation expression to the invoked executable.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Executable"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ExecutableInvocationExpression"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isAnnotationOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isAnnotationOf">
        <rdfs:label xml:lang="en">is annotation of</rdfs:label>
        <rdfs:comment xml:lang="en">The isAnnotationOf property relates an annotation to the annotated code element.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/AnnotationType"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isArrayOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isArrayOf">
        <rdfs:label xml:lang="en">is array of</rdfs:label>
        <rdfs:comment xml:lang="en">The isArrayOf property relates an arrray to the type of its elements at the finest grain. For instance, an array of type &quot;int[][][]&quot; is linked to the type &quot;int&quot;. The number of dimensions of the array is specified by the dimensions property.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ArrayType"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Type"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isAssertExpressionOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isAssertExpressionOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is subexpression of</rdfs:label>
        <rdfs:comment xml:lang="en">The isAssertExpressionOf property relates a boolean expression to the assert statement it is contained in.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/AssertStatement"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubExpressionOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isBodyOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isBodyOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is body of</rdfs:label>
        <rdfs:comment xml:lang="en">The isBodyOf property relates a block to the exexcutable or statement it is the body of.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/BlockStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubStatementOf"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Executable"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/LoopStatement"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/TryStatement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isCatchClauseOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isCatchClauseOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">is catch clause of</rdfs:label>
        <rdfs:comment xml:lang="en">The isCatchClauseOf property relates a catch clause to the corresponding try statement.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/CatchBlock"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/TryStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubStatementOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isConditionOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isConditionOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is condition of</rdfs:label>
        <rdfs:comment xml:lang="en">The isConditionOf property relates a if-then-else statement or a loop to its condition.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubExpressionOf"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/DoStatement"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/ForStatement"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/IfThenElseStatement"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/WhileStatement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isConstructedBy -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isConstructedBy">
        <rdfs:label xml:lang="en">is constructed by</rdfs:label>
        <rdfs:comment xml:lang="en">The isConstructedBy property relates a class to the executables that instantiates objects of that class.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Class"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Executable"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isReferencedBy"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isConstructorOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isConstructorOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">is constructor of</rdfs:label>
        <rdfs:comment xml:lang="en">The isConstructorOf property relates a constructor to the class it is declared by.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Constructor"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isDeclaredBy"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Class"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Enum"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isDeclaredBy -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isDeclaredBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">is declared by</rdfs:label>
        <rdfs:comment xml:lang="en">The isDeclaredBy property relates a code element to the element it is declared by.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#isPartOf"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isDependencyOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isDependencyOf">
        <rdfs:label xml:lang="en">is dependency of</rdfs:label>
        <rdfs:comment xml:lang="en">The isDependencyOf property relates a library to the projects that depend on this library.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Library"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Project"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isElseBranchOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isElseBranchOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is else branch of</rdfs:label>
        <rdfs:comment xml:lang="en">The isElseBranchOf property relates the statement in an else branch to the corresponding If-then-else statement</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/IfThenElseStatement"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubStatementOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isFieldOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isFieldOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">is field of</rdfs:label>
        <rdfs:comment xml:lang="en">The isFieldOf property relates a field to the class, interface or enum it is declared by.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/ComplexType"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Field"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isDeclaredBy"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isFinallyClauseOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isFinallyClauseOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is finally clause of</rdfs:label>
        <rdfs:comment xml:lang="en">The isFinallyClauseOf property relates the statement enclosed in a finally clause to the corresponding try statement.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/FinallyBlock"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/TryStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubStatementOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isForInitOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isForInitOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">is for init of</rdfs:label>
        <rdfs:comment xml:lang="en">The isForInitOf property relates an expression executed as initialization code of a basic for statement to the relative for statement.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/ForStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubExpressionOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isForUpdateOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isForUpdateOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">is for update of</rdfs:label>
        <rdfs:comment xml:lang="en">The isForUpdateOf property relates an expression evaluated as update code of a for statement at the end of every iteration, to the corresponding for statement.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/ForStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubExpressionOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isImplementedBy -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isImplementedBy">
        <rdfs:label xml:lang="en">is implemented by</rdfs:label>
        <rdfs:comment xml:lang="en">The isImplementedBy property relates an interface to the classes implementig that interface</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#generalizes"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Class"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Interface"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isInitializerOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isInitializerOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is initializer of</rdfs:label>
        <rdfs:comment xml:lang="en">The isInitializerOf property relates an expression used to initialize a variable, to the statement it is contained in.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/VariableDeclarationStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubExpressionOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isLeftHandSideOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isLeftHandSideOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is left hand side of</rdfs:label>
        <rdfs:comment xml:lang="en">The isLeftHandSideOf property relates an expression that is used as left hand side expression of an assignemnt, to the corresponding assignment expression</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/AssignmentExpression"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubExpressionOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isMethodOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isMethodOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">is method of</rdfs:label>
        <rdfs:comment xml:lang="en">The isMethodOf property relates a method to the class, enum or interface it is declared by.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/ComplexType"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Method"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isDeclaredBy"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isModifierOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isModifierOf">
        <rdfs:label xml:lang="en">is modifier of</rdfs:label>
        <rdfs:comment xml:lang="en">The isModifierOf property relates a modifier to the corresponding modifiable element.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Modifiable"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Modifier"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isOverriddenBy -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isOverriddenBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is overridden by</rdfs:label>
        <rdfs:comment xml:lang="en">The isOverridenBy property relates a method to the ones it is overridden by.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#generalizes"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Method"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Method"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/overrides"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isPackageOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isPackageOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is package of</rdfs:label>
        <rdfs:comment xml:lang="en">The isPackageOf property relates a package to the types it declares.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Package"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/declares"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/AnnotationType"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/ComplexType"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isParameterOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isParameterOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is parameter of</rdfs:label>
        <rdfs:comment xml:lang="en">The isParameterOf property relates a parameter to the corresponding executable.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Executable"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Parameter"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isProjectOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isProjectOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is project of</rdfs:label>
        <rdfs:comment xml:lang="en">The isProjectOf property relates a project to the packages it contains.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#hasPart"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Package"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Project"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isReferencedBy -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isReferencedBy">
        <rdfs:label xml:lang="en">is referenced by</rdfs:label>
        <rdfs:comment xml:lang="en">The isReferencedBy property relates a code element to the elements it is referenced by.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/references"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isReturnTypeOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isReturnTypeOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is return type of</rdfs:label>
        <rdfs:comment xml:lang="en">The isReturnTypeOf property relates a type to the methods that return objects of that type.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Method"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Type"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isTypeOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isReturnedBy -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isReturnedBy">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is returned by</rdfs:label>
        <rdfs:comment xml:lang="en">The isReturnedBy property relates a variable to the methods that return that variable.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Method"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Variable"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/returns"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isReturnedExpressionOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isReturnedExpressionOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is returned expression of</rdfs:label>
        <rdfs:comment xml:lang="en">The isReturnedExpressionOf property relates an expression returned by a method to the return statement it is contained in.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/ReturnStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubExpressionOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isSubExpressionOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isSubExpressionOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">is subexpression of</rdfs:label>
        <rdfs:comment xml:lang="en">The isSubExpressionOf property relates an expression to its parent expression.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#isPartOf"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Expression"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Statement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isSubProjectOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isSubProjectOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">is subproject of</rdfs:label>
        <rdfs:comment xml:lang="en">The isSubProjectOf property relates a project to its parent project.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#isPartOf"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Project"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Project"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isSubStatementOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isSubStatementOf">
        <rdfs:label xml:lang="en">is substatement of</rdfs:label>
        <rdfs:comment>The isSubStatementOf property relates a statement to the method, constructor or statement it is contained in.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#isPartOf"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Executable"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Statement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isSwitchLabelOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isSwitchLabelOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">is switch label of</rdfs:label>
        <rdfs:comment xml:lang="en">The isSwitchLabelOf property relates a case labeled block or a default block to the corresponding switch statement.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/LabeledBlock"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/SwitchStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubStatementOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isTargetOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isTargetOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is target of</rdfs:label>
        <rdfs:comment xml:lang="en">The isTargetOf property relates an expression used as target of a method invocation, to the corresponding method invocation.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/MethodInvocationExpression"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubExpressionOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isThenBranchOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isThenBranchOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is then branch of</rdfs:label>
        <rdfs:comment xml:lang="en">The isThenBranchOf property relates a statement enclosed in a then branch to the corresponding If-then-else statement</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/IfThenElseStatement"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubStatementOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isThrownBy -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isThrownBy">
        <rdfs:label xml:lang="en">is thrown by</rdfs:label>
        <rdfs:comment xml:lang="en">The isThrownBy property relates an exception to the executables it is thrown by.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Class"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Executable"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isReferencedBy"/>
        <owl:inverseOf rdf:resource="http://rdf.webofcode.org/woc/throws"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isThrownExpressionOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isThrownExpressionOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is thrown expression of</rdfs:label>
        <rdfs:comment xml:lang="en">The isThrownExpressionOf property relates a thrown expression, to the throw statement it is contained in.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/ThrowStatement"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/isSubExpressionOf"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/isTypeOf -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/isTypeOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:label xml:lang="en">is type of</rdfs:label>
        <rdfs:comment xml:lang="en">The isTypeOf property relates a type to the elements of that type.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Type"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Expression"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Method"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Variable"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/overrides -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/overrides">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">overrides</rdfs:label>
        <rdfs:comment xml:lang="en">The overrides property relates a method to the method it overrides.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://rdf-vocabulary.ddialliance.org/xkos#specializes"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Method"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Method"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/references -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/references">
        <rdfs:label xml:lang="en">references</rdfs:label>
        <rdfs:comment xml:lang="en">The references property relates a method or a constructor to the types, methods, constructors and fields it references.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/returns -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/returns">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">returns</rdfs:label>
        <rdfs:comment xml:lang="en">The returns property relates a method to the variable it returns, if any.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Method"/>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Variable"/>
    </owl:ObjectProperty>
    


    <!-- http://rdf.webofcode.org/woc/throws -->

    <owl:ObjectProperty rdf:about="http://rdf.webofcode.org/woc/throws">
        <rdfs:label xml:lang="en">throws</rdfs:label>
        <rdfs:comment xml:lang="en">The throws property relates a method or a constructor to the exceptions it declares to throw.</rdfs:comment>
        <rdfs:range rdf:resource="http://rdf.webofcode.org/woc/Class"/>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Executable"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/references"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#location -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#location">
        <rdfs:label>location</rdfs:label>
        <rdfs:comment>The relation between something and the point, 
 or other geometrical thing in space, where it is.  For example, the realtionship between
 a radio tower and a Point with a given lat and long.
 Or a relationship between a park and its outline as a closed arc of points, or a road and
 its location as a arc (a sequence of points).
 Clearly in practice there will be limit to the accuracy of any such statement, but one would expect
 an accuracy appropriate for the size of the object and uses such as mapping .
 </rdfs:comment>
        <rdfs:domain rdf:resource="http://purl.org/iot/ontology/iot-stream#IotStream"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#Point"/>
                    <rdf:Description rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeBySensor -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeBySensor">
        <rdfs:label xml:lang="en">made by sensor</rdfs:label>
        <skos:definition xml:lang="en">Relation between an Observation and the Sensor which made the Observation.</skos:definition>
        <rdfs:comment xml:lang="en">Relation between an Observation and the Sensor which made the Observation.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/sosa/madeObservation"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/sosa/madeObservation -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/sosa/madeObservation">
        <rdfs:label xml:lang="en">made observation</rdfs:label>
        <rdfs:comment xml:lang="en">Relation between a Sensor and an Observation made by the Sensor.</rdfs:comment>
        <skos:definition xml:lang="en">Relation between a Sensor and an Observation made by the Sensor.</skos:definition>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <schema:rangeIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/sosa/Sensor"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/iot/qoi#hasQuality -->

    <owl:ObjectProperty rdf:about="https://w3id.org/iot/qoi#hasQuality">
        <rdfs:label xml:lang="en">hasQuality</rdfs:label>
        <rdfs:comment xml:lang="en">Connects a quality to a data source.</rdfs:comment>
        <ns:term_status xml:lang="en">testing</ns:term_status>
        <rdfs:domain rdf:resource="http://purl.org/iot/ontology/iot-stream#StreamObservation"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/iot/qoi"/>
        <rdfs:range rdf:resource="https://w3id.org/iot/qoi#Quality"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.oclc.org/NET/UNIS/fiware/iot-lite#endpoint -->

    <owl:DatatypeProperty rdf:about="http://purl.oclc.org/NET/UNIS/fiware/iot-lite#endpoint">
        <rdfs:comment>Endpoint of the service. It is usually a URL where the service is available.</rdfs:comment>
        <rdfs:domain rdf:resource="http://purl.oclc.org/NET/UNIS/fiware/iot-lite#Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.oclc.org/NET/UNIS/fiware/iot-lite#interfaceDescription -->

    <owl:DatatypeProperty rdf:about="http://purl.oclc.org/NET/UNIS/fiware/iot-lite#interfaceDescription">
        <rdfs:comment>Interface Description of the service, e.g WADL, WSDL, NGSI9 etc.</rdfs:comment>
        <rdfs:domain rdf:resource="http://purl.oclc.org/NET/UNIS/fiware/iot-lite#Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.oclc.org/NET/UNIS/fiware/iot-lite#interfaceType -->

    <owl:DatatypeProperty rdf:about="http://purl.oclc.org/NET/UNIS/fiware/iot-lite#interfaceType">
        <rdfs:comment xml:lang="en">Defines the type of interface of the service endpoint, e.g. RESTful, NGSI-9, MQTT, CoAP etc.</rdfs:comment>
        <rdfs:domain rdf:resource="http://purl.oclc.org/NET/UNIS/fiware/iot-lite#Service"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#label -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iot/ontology/iot-stream#label">
        <rdfs:domain rdf:resource="http://purl.org/iot/ontology/iot-stream#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#methods -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iot/ontology/iot-stream#methods">
        <rdfs:domain rdf:resource="http://purl.org/iot/ontology/iot-stream#Analytics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#paramValues -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iot/ontology/iot-stream#paramValues">
        <rdfs:domain rdf:resource="http://purl.org/iot/ontology/iot-stream#Analytics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#parameters -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iot/ontology/iot-stream#parameters">
        <rdfs:domain rdf:resource="http://purl.org/iot/ontology/iot-stream#Analytics"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#windowEnd -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iot/ontology/iot-stream#windowEnd">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/iot/ontology/iot-stream#Analytics"/>
                    <rdf:Description rdf:about="http://purl.org/iot/ontology/iot-stream#Event"/>
                    <rdf:Description rdf:about="http://purl.org/iot/ontology/iot-stream#StreamObservation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/iot/ontology/iot-stream#windowStart -->

    <owl:DatatypeProperty rdf:about="http://purl.org/iot/ontology/iot-stream#windowStart">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.org/iot/ontology/iot-stream#Analytics"/>
                    <rdf:Description rdf:about="http://purl.org/iot/ontology/iot-stream#Event"/>
                    <rdf:Description rdf:about="http://purl.org/iot/ontology/iot-stream#StreamObservation"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:DatatypeProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasBuildFile -->

    <owl:DatatypeProperty rdf:about="http://rdf.webofcode.org/woc/hasBuildFile">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>build file</rdfs:label>
        <rdfs:comment>Links a project to the content of its build file.</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasCanonicalName -->

    <owl:DatatypeProperty rdf:about="http://rdf.webofcode.org/woc/hasCanonicalName">
        <rdfs:label xml:lang="en">has canonical name</rdfs:label>
        <rdfs:comment xml:lang="en">Links a class, enum or interface to its canonical name. For instance, the class Java.lang.String is linked to the string &quot;java.lang.string&quot;</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ComplexType"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasName"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasDimensions -->

    <owl:DatatypeProperty rdf:about="http://rdf.webofcode.org/woc/hasDimensions">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">dimensions</rdfs:label>
        <rdfs:comment xml:lang="en">Links an array to the number of its dimensions. As an example, an array of type &quot;int[][][]&quot; has a dimensions count of 3</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ArrayType"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasEndLine -->

    <owl:DatatypeProperty rdf:about="http://rdf.webofcode.org/woc/hasEndLine">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">end line</rdfs:label>
        <rdfs:comment xml:lang="en">Links a statement to the number of the last line it covers</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/BlockStatement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasLabel -->

    <owl:DatatypeProperty rdf:about="http://rdf.webofcode.org/woc/hasLabel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">label</rdfs:label>
        <rdfs:comment xml:lang="en">Links a labeled statement to its label</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
    </owl:DatatypeProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasLine -->

    <owl:DatatypeProperty rdf:about="http://rdf.webofcode.org/woc/hasLine">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">line</rdfs:label>
        <rdfs:comment xml:lang="en">Links a statement to the line it starts in</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Expression"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Statement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:DatatypeProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasName -->

    <owl:DatatypeProperty rdf:about="http://rdf.webofcode.org/woc/hasName">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">name</rdfs:label>
        <rdfs:comment xml:lang="en">Links a element to its name</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/CodeElement"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Library"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Project"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:DatatypeProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasPosition -->

    <owl:DatatypeProperty rdf:about="http://rdf.webofcode.org/woc/hasPosition">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">position</rdfs:label>
        <rdfs:comment xml:lang="en">Links a element to its position</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
    </owl:DatatypeProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasSimpleName -->

    <owl:DatatypeProperty rdf:about="http://rdf.webofcode.org/woc/hasSimpleName">
        <rdfs:label xml:lang="en">has simple name</rdfs:label>
        <rdfs:comment xml:lang="en">Links a class, enum or interface to its simple name. For instance, the simple name of the class java.lang.String is &quot;String&quot;</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/ComplexType"/>
        <rdfs:subPropertyOf rdf:resource="http://rdf.webofcode.org/woc/hasName"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasSourceCode -->

    <owl:DatatypeProperty rdf:about="http://rdf.webofcode.org/woc/hasSourceCode">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">source code</rdfs:label>
        <rdfs:comment xml:lang="en">Links a element to its source code</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://rdf.webofcode.org/woc/hasTargetedLabel -->

    <owl:DatatypeProperty rdf:about="http://rdf.webofcode.org/woc/hasTargetedLabel">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label>targeted label</rdfs:label>
        <rdfs:comment xml:lang="en">Links a break statement or a continue statement to the label it targets, if any</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/BreakStatement"/>
                    <rdf:Description rdf:about="http://rdf.webofcode.org/woc/ContinueStatement"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:DatatypeProperty>
    


    <!-- http://rdf.webofcode.org/woc/isVarArgs -->

    <owl:DatatypeProperty rdf:about="http://rdf.webofcode.org/woc/isVarArgs">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:label xml:lang="en">is var args</rdfs:label>
        <rdfs:comment xml:lang="en">True if an executable accepts a variable number of parameters, false otherwise</rdfs:comment>
        <rdfs:domain rdf:resource="http://rdf.webofcode.org/woc/Executable"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/sosa/hasSimpleResult -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/sosa/hasSimpleResult">
        <rdfs:label xml:lang="en">has simple result</rdfs:label>
        <skos:example xml:lang="en">For instance, the values 23 or true.</skos:example>
        <rdfs:comment xml:lang="en">The simple value of an Observation or Actuation or act of Sampling.</rdfs:comment>
        <skos:definition xml:lang="en">The simple value of an Observation or Actuation or act of Sampling.</skos:definition>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/sosa/resultTime -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/sosa/resultTime">
        <rdfs:label xml:lang="en">result time</rdfs:label>
        <skos:definition xml:lang="en">The result time is the instant of time when the Observation, Actuation or Sampling activity was completed.</skos:definition>
        <rdfs:comment xml:lang="en">The result time is the instant of time when the Observation, Actuation or Sampling activity was completed.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Actuation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <schema:domainIncludes rdf:resource="http://www.w3.org/ns/sosa/Sampling"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/iot/qoi#hasAbsoluteValue -->

    <owl:DatatypeProperty rdf:about="https://w3id.org/iot/qoi#hasAbsoluteValue">
        <rdfs:label xml:lang="en">hasAbsoluteValue</rdfs:label>
        <rdfs:comment xml:lang="en">Defines the absolute value for the measured quality. E.g. 60 for Age (unit is defined with hasUnitOfMeasurement).</rdfs:comment>
        <ns:term_status xml:lang="en">testing</ns:term_status>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topDataProperty"/>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/iot/qoi"/>
        <rdfs:domain rdf:resource="https://w3id.org/iot/qoi#Quality"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.oclc.org/NET/UNIS/fiware/iot-lite#Service -->

    <owl:Class rdf:about="http://purl.oclc.org/NET/UNIS/fiware/iot-lite#Service">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Service provided by an IoT Device</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.oclc.org/NET/ssnx/qu/qu#QuantityKind -->

    <owl:Class rdf:about="http://purl.oclc.org/NET/ssnx/qu/qu#QuantityKind">
        <rdfs:label>QuantityKind</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:seeAlso>http://www.omgsysml.org/qudv#Quantity</rdfs:seeAlso>
        <dc:source>skos:exactMatch &apos;QuantityKind&apos; [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv</dc:source>
        <rdfs:isDefinedBy>http://purl.oclc.org/NET/ssnx/qu</rdfs:isDefinedBy>
        <rdfs:comment>A QuantityKind is an abstract classifier that represents the [VIM] concept of &quot;kind of quantity&quot; that is defined as &quot;aspect
common to mutually comparable quantities.&quot; A QuantityKind represents the essence of a quantity without any numerical
value or unit. Quantities of the same kind within a given system of quantities have the same quantity dimension. However,
quantities of the same dimension are not necessarily of the same kind.</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.oclc.org/NET/ssnx/qu/qu#Unit -->

    <owl:Class rdf:about="http://purl.oclc.org/NET/ssnx/qu/qu#Unit">
        <rdfs:label>Unit</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <dc:source>skos:exactMatch &apos;Unit&apos; [SysML 1.2-QUDV] http://www.omgwiki.org/OMGSysML/doku.php?id=sysml-qudv:quantities_units_dimensions_values_qudv</dc:source>
        <rdfs:isDefinedBy>http://purl.oclc.org/NET/ssnx/qu</rdfs:isDefinedBy>
        <rdfs:seeAlso>http://www.omgsysml.org/qudv#Unit</rdfs:seeAlso>
        <rdfs:comment>A Unit is an abstract classifier that represents the [VIM] concept of &quot;measurement unit&quot; that is defined as &quot;real scalar quantity,
defined and adopted by convention, with which any other quantity of the same kind can be compared to express the ratio of the
two quantities as a number.&quot;</rdfs:comment>
    </owl:Class>
    


    <!-- http://purl.org/iot/ontology/iot-stream#Analytics -->

    <owl:Class rdf:about="http://purl.org/iot/ontology/iot-stream#Analytics">
        <rdfs:label>Analytics</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">The data analytics that has been applied to the IoT data stream.</rdfs:comment>
        <skos:definition xml:lang="en">The data analytics that has been applied to the IoT data stream.</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/iot/ontology/iot-stream#Event -->

    <owl:Class rdf:about="http://purl.org/iot/ontology/iot-stream#Event">
        <rdfs:label xml:lang="en">Event</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">The event that has been detected from an IoT data steam, and generated by an analytics process</rdfs:comment>
        <skos:definition xml:lang="en">The event that has been detected from an IoT data steam, and generated by an analytics process</skos:definition>
    </owl:Class>
    


    <!-- http://purl.org/iot/ontology/iot-stream#IotStream -->

    <owl:Class rdf:about="http://purl.org/iot/ontology/iot-stream#IotStream">
        <rdfs:label>IotStream</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <dc:description xml:lang="en">An abstraction that represents an IoT data stream that is generated by an IoT source. The IoTStream is the central concept in the ontology, whereby continuous stream observations belong to. It has a lifetime whch is defined by the stream start time and end time.</dc:description>
    </owl:Class>
    


    <!-- http://purl.org/iot/ontology/iot-stream#StreamObservation -->

    <owl:Class rdf:about="http://purl.org/iot/ontology/iot-stream#StreamObservation">
        <rdfs:label>StreamObservation</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/sosa/Observation"/>
        <skos:definition xml:lang="en">A observation made by a sensor device captured as a data point over a time instant, or as a subset of data points over a defined time interval.</skos:definition>
        <rdfs:comment xml:lang="en">A observation made by a sensor device captured as a data point over a time instant, or as a subset of data points over a defined time interval.</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/AccessModifier -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/AccessModifier">
        <rdfs:label xml:lang="en">Access Modifier</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Modifier"/>
        <rdfs:comment xml:lang="en">An access modifier</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ActualArgument -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ActualArgument">
        <rdfs:label>Actual Argument</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasPosition"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>The actual argument of a method</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/AnnotationType -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/AnnotationType">
        <rdfs:label xml:lang="en">Annotation</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Type"/>
        <rdfs:comment xml:lang="en">An annotation</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/AnonymousClass -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/AnonymousClass">
        <rdfs:label xml:lang="en">Anonymous Class</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Class"/>
        <rdfs:comment xml:lang="en">An anonymous class</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ArrayType -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ArrayType">
        <rdfs:label xml:lang="en">Array</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Type"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/isArrayOf"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Type"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasDimensions"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An array type</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/AssertStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/AssertStatement">
        <rdfs:label xml:lang="en">Assert Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasAssertExpression"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An assert statement</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/AssignmentExpression -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/AssignmentExpression">
        <rdfs:label>Assignment Expression</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasLeftHandSide"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An assignment expression. It involves one of the following operators:
=, *=, /=, %=, +=, -=, &lt;&lt;=, &gt;&gt;=, &gt;&gt;&gt;=, &amp;=, ^=, |=</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/BlockStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/BlockStatement">
        <rdfs:label xml:lang="en">Block Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:comment xml:lang="en">A block</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/BranchingStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/BranchingStatement">
        <rdfs:label xml:lang="en">Branching Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/ControlFlowStatement"/>
        <rdfs:comment xml:lang="en">A branching statement, namely a break statement, a continue statement or a return statement</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/BreakStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/BreakStatement">
        <rdfs:label xml:lang="en">Break Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/BranchingStatement"/>
        <rdfs:comment xml:lang="en">The BreakStatement class represents a break statement. The break statement has two forms: labeled and unlabeled. In case a break statement is labeled, the label is defined through the targetedLabel property</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/CaseLabeledBlock -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/CaseLabeledBlock">
        <rdfs:label xml:lang="en">Case Labeled Block</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/LabeledBlock"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A case-labeled list of statements</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/CatchBlock -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/CatchBlock">
        <rdfs:label xml:lang="en">Catch Block</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/BlockStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasCatchFormalParameter"/>
                <owl:someValuesFrom rdf:resource="http://rdf.webofcode.org/woc/Class"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A catch block</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Class -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Class">
        <rdfs:label xml:lang="en">Class</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/ComplexType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/extends"/>
                <owl:allValuesFrom rdf:resource="http://rdf.webofcode.org/woc/Class"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasDeclaration"/>
                <owl:allValuesFrom rdf:resource="http://rdf.webofcode.org/woc/ClassDeclarationStatement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/implements"/>
                <owl:allValuesFrom rdf:resource="http://rdf.webofcode.org/woc/Interface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/extends"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Class"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A class</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ClassDeclarationStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ClassDeclarationStatement">
        <rdfs:label xml:lang="en">Class Declaration Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/DeclarationStatement"/>
        <owl:disjointWith rdf:resource="http://rdf.webofcode.org/woc/VariableDeclarationStatement"/>
        <rdfs:comment xml:lang="en">A statement that corresponds to the declaration of a local class</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ClassInstanceCreationExpression -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ClassInstanceCreationExpression">
        <rdfs:label xml:lang="en">Class Instance Creation Expression</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/ExecutableInvocationExpression"/>
        <owl:disjointWith rdf:resource="http://rdf.webofcode.org/woc/MethodInvocationExpression"/>
        <rdfs:comment xml:lang="en">An expression that creates a class instance, in other words a constructor call</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/CodeElement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/CodeElement">
        <rdfs:label xml:lang="en">Code Element</rdfs:label>
        <rdfs:comment xml:lang="en">A generic element in source code</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ComplexType -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ComplexType">
        <rdfs:label xml:lang="en">Complex Type</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Modifiable"/>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Type"/>
        <rdfs:comment xml:lang="en">A class or an enumeration or an interface</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Constructor -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Constructor">
        <rdfs:label xml:lang="en">Constructor</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Executable"/>
        <owl:disjointWith rdf:resource="http://rdf.webofcode.org/woc/Method"/>
        <rdfs:comment xml:lang="en">A constructor of a Class</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ContinueStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ContinueStatement">
        <rdfs:label xml:lang="en">Continue Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/BranchingStatement"/>
        <rdfs:comment xml:lang="en">A continue statement</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ControlFlowStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ControlFlowStatement">
        <rdfs:label xml:lang="en">Control Flow Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:comment xml:lang="en">A control flow statement, that is a statement that regulates the order in which statements are executed.
Control Flow Statements break up the flow of execution by employing decision making, looping, or branching.</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/DecisionMakingStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/DecisionMakingStatement">
        <rdfs:label xml:lang="en">Decision Making Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/ControlFlowStatement"/>
        <rdfs:comment xml:lang="en">A Decision Making Statement, that is a statement that break up the flow of execution by employing decision making. It can either be a if-then-else statement or a switch statement.</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/DeclarationStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/DeclarationStatement">
        <rdfs:label xml:lang="en">Declaration statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:comment xml:lang="en">A statement that holds a declaration</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/DefaultLabeledBlock -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/DefaultLabeledBlock">
        <rdfs:label xml:lang="en">Default Labeled Block</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/LabeledBlock"/>
        <rdfs:comment xml:lang="en">A default-labeled block</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/DoStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/DoStatement">
        <rdfs:label xml:lang="en">Do Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/LoopStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasCondition"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A do-while statement</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Enum -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Enum">
        <rdfs:label xml:lang="en">Enum</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/ComplexType"/>
        <rdfs:comment xml:lang="en">An enumeration</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Executable -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Executable">
        <rdfs:label xml:lang="en">Executable</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Modifiable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/isVarArgs"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An executable block of code, namely a Method or a Constructor</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ExecutableInvocationExpression -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ExecutableInvocationExpression">
        <rdfs:label xml:lang="en">Executable invocation expression</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/invokes"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Executable"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An invocation of either a method or a constructor.</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Expression -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Expression">
        <rdfs:label>Expression</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasType"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Type"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasLine"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A generic expression</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ExpressionStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ExpressionStatement">
        <rdfs:label xml:lang="en">Expression statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An expression statement. that is a statement that wraps an expression</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Field -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Field">
        <rdfs:label xml:lang="en">Field</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Modifiable"/>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Variable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasDeclaration"/>
                <owl:allValuesFrom rdf:resource="http://rdf.webofcode.org/woc/FieldDeclarationStatement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/isDeclaredBy"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Class"/>
                            <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Enum"/>
                            <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Interface"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A class field</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/FieldDeclarationStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/FieldDeclarationStatement">
        <rdfs:label xml:lang="en">Field Declaration</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/VariableDeclarationStatement"/>
        <owl:disjointWith rdf:resource="http://rdf.webofcode.org/woc/LocalVariableDeclarationStatement"/>
        <rdfs:comment xml:lang="en">The declaration of a field</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/FinallyBlock -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/FinallyBlock">
        <rdfs:label xml:lang="en">Finally Block</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/BlockStatement"/>
        <rdfs:comment xml:lang="en">A finally block</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ForEachStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ForEachStatement">
        <rdfs:label xml:lang="en">ForEach Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/LoopStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasVariable"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Variable"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A for-each statement, also known as enhanced for statement</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ForStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ForStatement">
        <rdfs:label xml:lang="en">For Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/LoopStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasCondition"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A for statement</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/GradleProject -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/GradleProject">
        <rdfs:label xml:lang="en">Gradle Project</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Project"/>
        <rdfs:comment xml:lang="en">A gradle project</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/IfThenElseStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/IfThenElseStatement">
        <rdfs:label xml:lang="en">If-then-else statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/DecisionMakingStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasCondition"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasThenBranch"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://rdf.webofcode.org/woc/SwitchStatement"/>
        <rdfs:comment xml:lang="en">A If-then-else statement</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Interface -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Interface">
        <rdfs:label xml:lang="en">Interface</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/ComplexType"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/extends"/>
                <owl:allValuesFrom rdf:resource="http://rdf.webofcode.org/woc/Interface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An interface</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/LabeledBlock -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/LabeledBlock">
        <rdfs:label xml:lang="en">Labeled Block</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/BlockStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasNextStatement"/>
                <owl:allValuesFrom rdf:resource="http://rdf.webofcode.org/woc/LabeledBlock"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A labeled block of code, namely a case-labeled block or a default-labeled block</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Library -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Library">
        <rdfs:label xml:lang="en">Library</rdfs:label>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasName"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A library</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/LocalVariable -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/LocalVariable">
        <rdfs:label xml:lang="en">Local Variable</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Variable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/isDeclaredBy"/>
                <owl:allValuesFrom rdf:resource="http://rdf.webofcode.org/woc/Executable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A local variable</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/LocalVariableDeclarationStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/LocalVariableDeclarationStatement">
        <rdfs:label xml:lang="en">Local Variable Declaration Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/VariableDeclarationStatement"/>
        <rdfs:comment xml:lang="en">A local variable declaration</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/LoopStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/LoopStatement">
        <rdfs:label xml:lang="en">Loop Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/ControlFlowStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasBody"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/BlockStatement"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A loop statement.</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/MavenProject -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/MavenProject">
        <rdfs:label xml:lang="en">Maven Project</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Project"/>
        <rdfs:comment xml:lang="en">A maven project</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Method -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Method">
        <rdfs:label xml:lang="en">Method</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Executable"/>
        <rdfs:comment xml:lang="en">A Method</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/MethodInvocationExpression -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/MethodInvocationExpression">
        <rdfs:label xml:lang="en">Method Invocation Expression</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/ExecutableInvocationExpression"/>
        <rdfs:comment xml:lang="en">A method call</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Modifiable -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Modifiable">
        <rdfs:label xml:lang="en">Modifiable</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasModifier"/>
                <owl:someValuesFrom rdf:resource="http://rdf.webofcode.org/woc/Modifier"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasModifier"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/AccessModifier"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An element that can have a modifier</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Modifier -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Modifier">
        <rdfs:label xml:lang="en">Modifier</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:comment xml:lang="en">A modifier</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Package -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Package">
        <rdfs:label xml:lang="en">Package</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:comment xml:lang="en">A Package</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Parameter -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Parameter">
        <rdfs:label xml:lang="en">Parameter</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Variable"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasPosition"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A formal parameter</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ParameterizedType -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ParameterizedType">
        <rdfs:label>Parameterized Type</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Type"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasActualTypeArgument"/>
                <owl:someValuesFrom rdf:resource="http://rdf.webofcode.org/woc/TypeArgument"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasGenericType"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/ComplexType"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A parameterized type is a particular parameterization of a generic type denoted by a specified list of type arguments</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/PrimitiveType -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/PrimitiveType">
        <rdfs:label>Primitive Type</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Type"/>
        <rdfs:comment>A primitive type</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Project -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Project">
        <rdfs:label xml:lang="en">Project</rdfs:label>
        <rdfs:comment xml:lang="en">A project</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ReturnStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ReturnStatement">
        <rdfs:label xml:lang="en">Return Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/BranchingStatement"/>
        <rdfs:comment xml:lang="en">A return statement</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Statement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Statement">
        <rdfs:label>Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasLine"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasPosition"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A generic statement</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/SwitchStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/SwitchStatement">
        <rdfs:label xml:lang="en">Switch Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/DecisionMakingStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasSubExpression"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A switch statement</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/SynchronizedStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/SynchronizedStatement">
        <rdfs:label xml:lang="en">Synchronized Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:comment xml:lang="en">A synchronized statement, that is a statement that acquires a mutual-exclusion lock on behalf of the executiing-thread, executes a block, then release the lock.
In java it is of the form:
synchronized &lt;Expression&gt; &lt;Block&gt;</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/ThrowStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/ThrowStatement">
        <rdfs:label xml:lang="en">Throw Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasThrownExpression"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A throw statement, that is a statement that causes an exception to be thrown</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/TryStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/TryStatement">
        <rdfs:label xml:lang="en">Try Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Statement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasBody"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/BlockStatement"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A try statement</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Type -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Type">
        <rdfs:label xml:lang="en">Type</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:comment xml:lang="en">A type</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/TypeArgument -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/TypeArgument">
        <rdfs:label xml:lang="en">Type Argument</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:comment xml:lang="en">This class defines the actual type argument of a parameterized type</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/TypeVariable -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/TypeVariable">
        <rdfs:label>Type Variable</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Type"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/extends"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Class"/>
                            <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Interface"/>
                            <rdf:Description rdf:about="http://rdf.webofcode.org/woc/ParameterizedType"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A type variable is an unqualified identifier used as a type. It is introduced by the declaration of a generic class, interface, method, or constructor</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Variable -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Variable">
        <rdfs:label xml:lang="en">Variable</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/CodeElement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasType"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Type"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A variable</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/VariableDeclarationStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/VariableDeclarationStatement">
        <rdfs:label xml:lang="en">Variable Declaration</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/DeclarationStatement"/>
        <rdfs:comment xml:lang="en">A statement that represents the declaration of a variable</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/WhileStatement -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/WhileStatement">
        <rdfs:label xml:lang="en">While Statement</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/LoopStatement"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasCondition"/>
                <owl:onClass rdf:resource="http://rdf.webofcode.org/woc/Expression"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A while statement</rdfs:comment>
    </owl:Class>
    


    <!-- http://rdf.webofcode.org/woc/Wildcard -->

    <owl:Class rdf:about="http://rdf.webofcode.org/woc/Wildcard">
        <rdfs:label xml:lang="en">Wildcard</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://rdf.webofcode.org/woc/Type"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/extends"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Class"/>
                            <rdf:Description rdf:about="http://rdf.webofcode.org/woc/Interface"/>
                            <rdf:Description rdf:about="http://rdf.webofcode.org/woc/ParameterizedType"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasSuperBound"/>
                <owl:allValuesFrom rdf:resource="http://rdf.webofcode.org/woc/Type"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A wildcard</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.opengis.net/ont/geosparql#Coverage -->

    <owl:Class rdf:about="http://www.opengis.net/ont/geosparql#Coverage">
        <rdfs:label>Coverage</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    </owl:Class>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#Point -->

    <owl:Class rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#Point">
        <rdfs:label>point</rdfs:label>
        <rdfs:label>geo:Point</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
        <rdfs:comment> 
Uniquely identified by lat/long/alt. i.e.

spaciallyIntersects(P1, P2) :- lat(P1, LAT), long(P1, LONG), alt(P1, ALT),
  lat(P2, LAT), long(P2, LONG), alt(P2, ALT).

sameThing(P1, P2) :- type(P1, Point), type(P2, Point), spaciallyIntersects(P1, P2).
  </rdfs:comment>
        <rdfs:comment>A point, typically described using a coordinate system relative to Earth, such as WGS84.
  </rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing -->

    <owl:Class rdf:about="http://www.w3.org/2003/01/geo/wgs84_pos#SpatialThing"/>
    


    <!-- http://www.w3.org/ns/sosa/Observation -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Observation">
        <rdfs:label xml:lang="en">Observation</rdfs:label>
        <skos:definition xml:lang="en">Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with.</skos:definition>
        <rdfs:comment xml:lang="en">Act of carrying out an (Observation) Procedure to estimate or calculate a value of a property of a FeatureOfInterest. Links to a Sensor to describe what made the Observation and how; links to an ObservableProperty to describe what the result is an estimate of, and to a FeatureOfInterest to detail what that property was associated with.</rdfs:comment>
        <skos:example xml:lang="en">The activity of estimating the intensity of an Earthquake using the Mercalli intensity scale is an Observation as is measuring the moment magnitude, i.e., the energy released by said earthquake.</skos:example>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/Platform -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Platform">
        <rdfs:label xml:lang="en">Platform</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <skos:definition xml:lang="en">A Platform is an entity that hosts other entities, particularly Sensors, Actuators, Samplers, and other Platforms.</skos:definition>
        <rdfs:comment xml:lang="en">A Platform is an entity that hosts other entities, particularly Sensors, Actuators, Samplers, and other Platforms.</rdfs:comment>
        <skos:example xml:lang="en">A post, buoy, vehicle, ship, aircraft, satellite, cell-phone, human or animal may act as platforms for (technical or biological) sensors or actuators.</skos:example>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:Class>
    


    <!-- http://www.w3.org/ns/sosa/Sensor -->

    <owl:Class rdf:about="http://www.w3.org/ns/sosa/Sensor">
        <rdfs:label xml:lang="en">Sensor</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <skos:example xml:lang="en">Accelerometers, gyroscopes, barometers, magnetometers, and so forth are Sensors that are typically mounted on a modern smart phone (which acts as Platform). Other examples of sensors include the human eyes.</skos:example>
        <skos:definition xml:lang="en">Device, agent (including humans), or software (simulation) involved in, or implementing, a Procedure. Sensors respond to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations, and generate a Result. Sensors can be hosted by Platforms.</skos:definition>
        <rdfs:comment xml:lang="en">Device, agent (including humans), or software (simulation) involved in, or implementing, a Procedure. Sensors respond to a stimulus, e.g., a change in the environment, or input data composed from the results of prior Observations, and generate a Result. Sensors can be hosted by Platforms.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.w3.org/ns/sosa/"/>
    </owl:Class>
    


    <!-- https://w3id.org/iot/qoi#Age -->

    <owl:Class rdf:about="https://w3id.org/iot/qoi#Age">
        <rdfs:label xml:lang="en">Age</rdfs:label>
        <rdfs:subClassOf rdf:resource="https://w3id.org/iot/qoi#Timeliness"/>
        <owl:disjointWith rdf:resource="https://w3id.org/iot/qoi#Frequency"/>
        <rdfs:comment xml:lang="en">Defines the age of provided information.</rdfs:comment>
        <ns:term_status xml:lang="en">stable</ns:term_status>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/iot/qoi"/>
    </owl:Class>
    


    <!-- https://w3id.org/iot/qoi#Artificiality -->

    <owl:Class rdf:about="https://w3id.org/iot/qoi#Artificiality">
        <rdfs:label xml:lang="en">Artificiality</rdfs:label>
        <rdfs:subClassOf rdf:resource="https://w3id.org/iot/qoi#Quality"/>
        <rdfs:comment xml:lang="en">The degreee of used sensor fusion techniques or definition of a direct measurement from a single data source.</rdfs:comment>
        <ns:term_status xml:lang="en">testing</ns:term_status>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/iot/qoi"/>
    </owl:Class>
    


    <!-- https://w3id.org/iot/qoi#Completeness -->

    <owl:Class rdf:about="https://w3id.org/iot/qoi#Completeness">
        <rdfs:label xml:lang="en">Completeness</rdfs:label>
        <rdfs:subClassOf rdf:resource="https://w3id.org/iot/qoi#Quality"/>
        <rdfs:comment xml:lang="en">The degreee of of completeness of all expected attributes/values within a single provided date value.</rdfs:comment>
        <ns:term_status xml:lang="en">stable</ns:term_status>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/iot/qoi"/>
    </owl:Class>
    


    <!-- https://w3id.org/iot/qoi#Concordance -->

    <owl:Class rdf:about="https://w3id.org/iot/qoi#Concordance">
        <rdfs:label xml:lang="en">Concordance</rdfs:label>
        <rdfs:subClassOf rdf:resource="https://w3id.org/iot/qoi#Quality"/>
        <rdfs:comment xml:lang="en">Describes the agreement between information provided by the monitored data source and information provided by other independent data sources providing correlating effects.</rdfs:comment>
        <ns:term_status xml:lang="en">testing</ns:term_status>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/iot/qoi"/>
    </owl:Class>
    


    <!-- https://w3id.org/iot/qoi#Frequency -->

    <owl:Class rdf:about="https://w3id.org/iot/qoi#Frequency">
        <rdfs:label xml:lang="en">Frequency</rdfs:label>
        <rdfs:subClassOf rdf:resource="https://w3id.org/iot/qoi#Timeliness"/>
        <rdfs:comment xml:lang="en">Defines the frequency in which information is updated.</rdfs:comment>
        <ns:term_status xml:lang="en">stable</ns:term_status>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/iot/qoi"/>
    </owl:Class>
    


    <!-- https://w3id.org/iot/qoi#Plausibility -->

    <owl:Class rdf:about="https://w3id.org/iot/qoi#Plausibility">
        <rdfs:label xml:lang="en">Plausibility</rdfs:label>
        <rdfs:subClassOf rdf:resource="https://w3id.org/iot/qoi#Quality"/>
        <rdfs:comment xml:lang="en">Defines if data provided by a data sources makes sense regarding all the probabilistic knowledge about the data source. E.g. for a temperature sensore the temperature is within a certain value range.</rdfs:comment>
        <ns:term_status xml:lang="en">stable</ns:term_status>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/iot/qoi"/>
    </owl:Class>
    


    <!-- https://w3id.org/iot/qoi#Quality -->

    <owl:Class rdf:about="https://w3id.org/iot/qoi#Quality">
        <rdfs:label>Quality</rdfs:label>
        <rdfs:comment>Top class for quality describing classes for IoT data sources.</rdfs:comment>
        <ns:term_status xml:lang="en">stable</ns:term_status>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/iot/qoi"/>
    </owl:Class>
    


    <!-- https://w3id.org/iot/qoi#Timeliness -->

    <owl:Class rdf:about="https://w3id.org/iot/qoi#Timeliness">
        <rdfs:label xml:lang="en">Timeliness</rdfs:label>
        <rdfs:subClassOf rdf:resource="https://w3id.org/iot/qoi#Quality"/>
        <rdfs:comment xml:lang="en">Timliness defines a category with metrics, which rate if a data source provides data within a defined timespan or of a defined age.</rdfs:comment>
        <ns:term_status xml:lang="en">stable</ns:term_status>
        <rdfs:isDefinedBy rdf:resource="https://w3id.org/iot/qoi"/>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://rdf.webofcode.org/woc/Abstract -->

    <owl:NamedIndividual rdf:about="http://rdf.webofcode.org/woc/Abstract">
        <rdf:type rdf:resource="http://rdf.webofcode.org/woc/Modifier"/>
        <rdfs:label xml:lang="en">Abstract</rdfs:label>
        <rdfs:comment xml:lang="en">The abstract modifier</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://rdf.webofcode.org/woc/Boolean -->

    <owl:NamedIndividual rdf:about="http://rdf.webofcode.org/woc/Boolean">
        <rdf:type rdf:resource="http://rdf.webofcode.org/woc/PrimitiveType"/>
        <rdfs:label xml:lang="en">Boolean</rdfs:label>
        <rdfs:comment xml:lang="en">The boolean type</rdfs:comment>
    </owl:NamedIndividual>
    


    <!-- http://rdf.webofcode.org/woc/Byte -->

    <owl:NamedIndividual rdf:about="http://rdf.webofcode.org/woc/Byte">
