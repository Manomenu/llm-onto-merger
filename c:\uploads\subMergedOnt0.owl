    <!-- http://ekaw#volumeContainsPaper -->

    <owl:ObjectProperty rdf:about="http://ekaw#volumeContainsPaper">
        <owl:inverseOf rdf:resource="http://ekaw#paperInVolume"/>
    </owl:ObjectProperty>
    


    <!-- http://ekaw#writtenBy -->

    <owl:ObjectProperty rdf:about="http://ekaw#writtenBy">
