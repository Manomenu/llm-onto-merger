        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/hasDeclaration"/>
                <owl:allValuesFrom rdf:resource="http://rdf.webofcode.org/woc/ClassDeclarationStatement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/implements"/>
                <owl:allValuesFrom rdf:resource="http://merged#SWO9000050_Interface"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://rdf.webofcode.org/woc/extends"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A class</rdfs:comment>
    </owl:Class>
    


