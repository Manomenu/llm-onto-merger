    <!-- http://ekaw#authorOf -->

    <owl:ObjectProperty rdf:about="http://ekaw#authorOf">
        <rdfs:range rdf:resource="http://ekaw#Document"/>
        <rdfs:domain rdf:resource="http://merged#Person"/>
    </owl:ObjectProperty>
    


    <!-- http://ekaw#coversTopic -->

    <owl:ObjectProperty rdf:about="http://ekaw#coversTopic">
        <rdfs:range rdf:resource="http://merged#ResearchTopic"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://merged#Contribution_Paper"/>
                    <rdf:Description rdf:about="http://merged#Event"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:ObjectProperty>
    


    <!-- http://ekaw#eventOnList -->

    <owl:ObjectProperty rdf:about="http://ekaw#eventOnList">
        <owl:inverseOf rdf:resource="http://ekaw#listsEvent"/>
        <rdfs:domain rdf:resource="http://merged#Event"/>
