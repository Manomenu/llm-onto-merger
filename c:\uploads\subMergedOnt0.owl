    </owl:DatatypeProperty>
    


    <!-- http://confOf#hasTitle -->

    <owl:DatatypeProperty rdf:about="http://confOf#hasTitle">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
        <rdfs:domain rdf:resource="http://merged#Contribution_Paper"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://confOf#hasVAT -->

    <owl:DatatypeProperty rdf:about="http://confOf#hasVAT">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">value added tax
</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://merged#ScientificEvent_WorkingEvent"/>
                    <rdf:Description rdf:about="http://merged#SocialEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:DatatypeProperty>
    


    <!-- http://confOf#has_short_title -->

    <owl:DatatypeProperty rdf:about="http://confOf#has_short_title">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://merged#ScientificEvent_WorkingEvent"/>
                    <rdf:Description rdf:about="http://merged#SocialEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:DatatypeProperty>
    


    <!-- http://confOf#has_title -->

    <owl:DatatypeProperty rdf:about="http://confOf#has_title">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://merged#ScientificEvent_WorkingEvent"/>
                    <rdf:Description rdf:about="http://merged#SocialEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:DatatypeProperty>
    


    <!-- http://confOf#location -->

    <owl:DatatypeProperty rdf:about="http://confOf#location">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">where the event is being held</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://merged#ScientificEvent_WorkingEvent"/>
                    <rdf:Description rdf:about="http://merged#SocialEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:DatatypeProperty>
    


    <!-- http://confOf#maxChoice -->

    <owl:DatatypeProperty rdf:about="http://confOf#maxChoice">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool
</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://merged#ScientificEvent_WorkingEvent"/>
                    <rdf:Description rdf:about="http://merged#SocialEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:DatatypeProperty>
    


    <!-- http://confOf#minChoice -->

    <owl:DatatypeProperty rdf:about="http://confOf#minChoice">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool
</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://merged#ScientificEvent_WorkingEvent"/>
                    <rdf:Description rdf:about="http://merged#SocialEvent"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
    </owl:DatatypeProperty>
    


    <!-- http://confOf#remark -->

    <owl:DatatypeProperty rdf:about="http://confOf#remark">
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
        <rdfs:domain rdf:resource="http://merged#Contribution_Paper"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://confOf#starts_on -->

    <owl:DatatypeProperty rdf:about="http://confOf#starts_on">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
        <rdfs:domain rdf:resource="http://merged#Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://confOf#Administrative_event -->

    <owl:Class rdf:about="http://confOf#Administrative_event">
        <rdfs:subClassOf rdf:resource="http://merged#Event"/>
        <owl:disjointWith rdf:resource="http://merged#ScientificEvent_WorkingEvent"/>
        <owl:disjointWith rdf:resource="http://merged#SocialEvent"/>
    </owl:Class>
    


    <!-- http://confOf#Administrator -->

    <owl:Class rdf:about="http://confOf#Administrator">
        <rdfs:subClassOf rdf:resource="http://merged#Person"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
    </owl:Class>
    


    <!-- http://confOf#Assistant -->

    <owl:Class rdf:about="http://confOf#Assistant">
        <rdfs:subClassOf rdf:resource="http://merged#Person"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
    </owl:Class>
    


    <!-- http://confOf#Camera_Ready_event -->

    <owl:Class rdf:about="http://confOf#Camera_Ready_event">
        <rdfs:subClassOf rdf:resource="http://confOf#Administrative_event"/>
        <owl:disjointWith rdf:resource="http://confOf#Registration_of_participants_event"/>
        <owl:disjointWith rdf:resource="http://confOf#Reviewing_event"/>
        <owl:disjointWith rdf:resource="http://confOf#Reviewing_results_event"/>
        <owl:disjointWith rdf:resource="http://confOf#Submission_event"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Final upload of accepted contributions</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
    </owl:Class>
    


    <!-- http://confOf#City -->

    <owl:Class rdf:about="http://confOf#City">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:disjointWith rdf:resource="http://merged#Contribution_Paper"/>
        <owl:disjointWith rdf:resource="http://merged#Event"/>
        <owl:disjointWith rdf:resource="http://merged#Organisation_Organization"/>
        <owl:disjointWith rdf:resource="http://merged#Person"/>
        <owl:disjointWith rdf:resource="http://merged#ResearchTopic"/>
    </owl:Class>
    


    <!-- http://confOf#Company -->

    <owl:Class rdf:about="http://confOf#Company">
        <rdfs:subClassOf rdf:resource="http://merged#Organisation_Organization"/>
        <owl:disjointWith rdf:resource="http://merged#University"/>
    </owl:Class>
    


    <!-- http://confOf#Country -->

    <owl:Class rdf:about="http://confOf#Country">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <owl:disjointWith rdf:resource="http://merged#Contribution_Paper"/>
        <owl:disjointWith rdf:resource="http://merged#Event"/>
        <owl:disjointWith rdf:resource="http://merged#Organisation_Organization"/>
        <owl:disjointWith rdf:resource="http://merged#Person"/>
        <owl:disjointWith rdf:resource="http://merged#ResearchTopic"/>
    </owl:Class>
    


    <!-- http://confOf#Member -->

    <owl:Class rdf:about="http://confOf#Member">
        <rdfs:subClassOf rdf:resource="http://merged#ConferenceParticipant"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
    </owl:Class>
    


    <!-- http://confOf#Paper -->

    <owl:Class rdf:about="http://confOf#Paper">
        <rdfs:subClassOf rdf:resource="http://merged#Contribution_Paper"/>
        <owl:disjointWith rdf:resource="http://confOf#Short_paper"/>
        <owl:disjointWith rdf:resource="http://merged#PosterPaper"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
    </owl:Class>
    


    <!-- http://confOf#Reception -->

    <owl:Class rdf:about="http://confOf#Reception">
        <rdfs:subClassOf rdf:resource="http://merged#SocialEvent"/>
        <owl:disjointWith rdf:resource="http://merged#ConferenceBanquet"/>
        <owl:disjointWith rdf:resource="http://merged#ConferenceTrip"/>
    </owl:Class>
    


    <!-- http://confOf#Registration_of_participants_event -->

    <owl:Class rdf:about="http://confOf#Registration_of_participants_event">
        <rdfs:subClassOf rdf:resource="http://confOf#Administrative_event"/>
        <owl:disjointWith rdf:resource="http://confOf#Reviewing_event"/>
        <owl:disjointWith rdf:resource="http://confOf#Reviewing_results_event"/>
        <owl:disjointWith rdf:resource="http://confOf#Submission_event"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Registration of new ConfTool users</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
    </owl:Class>
    


    <!-- http://confOf#Regular -->

    <owl:Class rdf:about="http://confOf#Regular">
        <rdfs:subClassOf rdf:resource="http://merged#ConferenceParticipant"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
    </owl:Class>
    


    <!-- http://confOf#Reviewing_event -->

    <owl:Class rdf:about="http://confOf#Reviewing_event">
        <rdfs:subClassOf rdf:resource="http://confOf#Administrative_event"/>
        <owl:disjointWith rdf:resource="http://confOf#Reviewing_results_event"/>
        <owl:disjointWith rdf:resource="http://confOf#Submission_event"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Reviewing procedure for submitted contributions</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
    </owl:Class>
    


    <!-- http://confOf#Reviewing_results_event -->

    <owl:Class rdf:about="http://confOf#Reviewing_results_event">
        <rdfs:subClassOf rdf:resource="http://confOf#Administrative_event"/>
        <owl:disjointWith rdf:resource="http://confOf#Submission_event"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Results of the reviewing procedures, accessable to authors</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
    </owl:Class>
    


    <!-- http://confOf#Science_Worker -->

    <owl:Class rdf:about="http://confOf#Science_Worker">
        <rdfs:subClassOf rdf:resource="http://merged#Person"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">price category - science worker</rdfs:comment>
    </owl:Class>
    


    <!-- http://confOf#Short_paper -->

    <owl:Class rdf:about="http://confOf#Short_paper">
        <rdfs:subClassOf rdf:resource="http://merged#Contribution_Paper"/>
        <owl:disjointWith rdf:resource="http://merged#PosterPaper"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
    </owl:Class>
    


    <!-- http://confOf#Submission_event -->

    <owl:Class rdf:about="http://confOf#Submission_event">
        <rdfs:subClassOf rdf:resource="http://confOf#Administrative_event"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Submission of contributions</rdfs:comment>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
    </owl:Class>
    


    <!-- http://confOf#Volunteer -->

    <owl:Class rdf:about="http://confOf#Volunteer">
        <rdfs:subClassOf rdf:resource="http://merged#Person"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">confTool</rdfs:comment>
    </owl:Class>
    


    <!-- http://ekaw#Abstract -->

    <owl:Class rdf:about="http://ekaw#Abstract">
        <rdfs:subClassOf rdf:resource="http://ekaw#Document"/>
    </owl:Class>
    


    <!-- http://ekaw#Academic_Institution -->

    <owl:Class rdf:about="http://ekaw#Academic_Institution">
        <rdfs:subClassOf rdf:resource="http://merged#Organisation_Organization"/>
        <owl:disjointWith rdf:resource="http://ekaw#Organising_Agency"/>
    </owl:Class>
    


    <!-- http://ekaw#Accepted_Paper -->

    <owl:Class rdf:about="http://ekaw#Accepted_Paper">
        <rdfs:subClassOf rdf:resource="http://ekaw#Evaluated_Paper"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ekaw#hasReview"/>
                <owl:someValuesFrom rdf:resource="http://ekaw#Positive_Review"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://ekaw#Camera_Ready_Paper"/>
        <owl:disjointWith rdf:resource="http://ekaw#Rejected_Paper"/>
        <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Accepted paper to become part of proceedings. 
Note that camera-ready paper is not considered as &apos;accepted paper&apos;, as it was accepted in a different form!</rdfs:comment>
    </owl:Class>
    


    <!-- http://ekaw#Agency_Staff_Member -->

    <owl:Class rdf:about="http://ekaw#Agency_Staff_Member">
        <rdfs:subClassOf rdf:resource="http://merged#Person"/>
    </owl:Class>
    


    <!-- http://ekaw#Assigned_Paper -->

    <owl:Class rdf:about="http://ekaw#Assigned_Paper">
        <rdfs:subClassOf rdf:resource="http://ekaw#Submitted_Paper"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ekaw#hasReviewer"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ekaw#Camera_Ready_Paper -->

    <owl:Class rdf:about="http://ekaw#Camera_Ready_Paper">
        <rdfs:subClassOf rdf:resource="http://merged#Contribution_Paper"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ekaw#updatedVersionOf"/>
                <owl:someValuesFrom rdf:resource="http://ekaw#Accepted_Paper"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ekaw#writtenBy"/>
                <owl:someValuesFrom rdf:resource="http://merged#ConferenceParticipant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://ekaw#Evaluated_Paper"/>
        <owl:disjointWith rdf:resource="http://ekaw#Submitted_Paper"/>
    </owl:Class>
    


    <!-- http://ekaw#Conference_Paper -->

    <owl:Class rdf:about="http://ekaw#Conference_Paper">
        <rdfs:subClassOf rdf:resource="http://merged#Contribution_Paper"/>
        <owl:disjointWith rdf:resource="http://ekaw#Workshop_Paper"/>
    </owl:Class>
    


    <!-- http://ekaw#Conference_Proceedings -->

    <owl:Class rdf:about="http://ekaw#Conference_Proceedings">
        <rdfs:subClassOf rdf:resource="http://ekaw#Proceedings"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ekaw#volumeContainsPaper"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://ekaw#Conference_Paper"/>
                            <rdf:Description rdf:about="http://ekaw#Invited_Talk_Abstract"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ekaw#Conference_Session -->

    <owl:Class rdf:about="http://ekaw#Conference_Session">
        <rdfs:subClassOf rdf:resource="http://ekaw#Session"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ekaw#partOfEvent"/>
                <owl:someValuesFrom rdf:resource="http://merged#Conference"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://ekaw#Workshop_Session"/>
    </owl:Class>
    


    <!-- http://ekaw#Contributed_Talk -->

    <owl:Class rdf:about="http://ekaw#Contributed_Talk">
        <rdfs:subClassOf rdf:resource="http://ekaw#Individual_Presentation"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ekaw#presentationOfPaper"/>
                <owl:someValuesFrom rdf:resource="http://ekaw#Camera_Ready_Paper"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ekaw#presentationOfPaper"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://ekaw#Invited_Talk"/>
        <owl:disjointWith rdf:resource="http://ekaw#Session"/>
        <owl:disjointWith rdf:resource="http://ekaw#Track"/>
        <owl:disjointWith rdf:resource="http://merged#Conference"/>
        <owl:disjointWith rdf:resource="http://merged#SocialEvent"/>
        <owl:disjointWith rdf:resource="http://merged#Tutorial"/>
    </owl:Class>
    


    <!-- http://ekaw#Demo_Chair -->

    <owl:Class rdf:about="http://ekaw#Demo_Chair">
        <rdfs:subClassOf rdf:resource="http://merged#ConferenceParticipant"/>
    </owl:Class>
    


    <!-- http://ekaw#Demo_Paper -->

    <owl:Class rdf:about="http://ekaw#Demo_Paper">
        <rdfs:subClassOf rdf:resource="http://merged#Contribution_Paper"/>
        <owl:disjointWith rdf:resource="http://ekaw#Industrial_Paper"/>
        <owl:disjointWith rdf:resource="http://ekaw#Regular_Paper"/>
        <owl:disjointWith rdf:resource="http://merged#PosterPaper"/>
    </owl:Class>
    


    <!-- http://ekaw#Demo_Session -->

    <owl:Class rdf:about="http://ekaw#Demo_Session">
        <rdfs:subClassOf rdf:resource="http://ekaw#Session"/>
        <owl:disjointWith rdf:resource="http://ekaw#Poster_Session"/>
        <owl:disjointWith rdf:resource="http://ekaw#Regular_Session"/>
    </owl:Class>
    


    <!-- http://ekaw#Document -->

    <owl:Class rdf:about="http://ekaw#Document">
        <owl:disjointWith rdf:resource="http://merged#Person"/>
    </owl:Class>
    


    <!-- http://ekaw#Early-Registered_Participant -->

    <owl:Class rdf:about="http://ekaw#Early-Registered_Participant">
        <rdfs:subClassOf rdf:resource="http://merged#ConferenceParticipant"/>
        <owl:disjointWith rdf:resource="http://ekaw#Late-Registered_Participant"/>
    </owl:Class>
    


    <!-- http://ekaw#Evaluated_Paper -->

    <owl:Class rdf:about="http://ekaw#Evaluated_Paper">
        <rdfs:subClassOf rdf:resource="http://ekaw#Assigned_Paper"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://ekaw#hasReview"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://ekaw#Flyer -->

    <owl:Class rdf:about="http://ekaw#Flyer">
        <rdfs:subClassOf rdf:resource="http://ekaw#Document"/>
        <owl:disjointWith rdf:resource="http://ekaw#Multi-author_Volume"/>
        <owl:disjointWith rdf:resource="http://ekaw#Proceedings"/>
        <owl:disjointWith rdf:resource="http://ekaw#Programme_Brochure"/>
        <owl:disjointWith rdf:resource="http://ekaw#Review"/>
        <owl:disjointWith rdf:resource="http://ekaw#Web_Site"/>
        <owl:disjointWith rdf:resource="http://merged#Contribution_Paper"/>
    </owl:Class>
    


    <!-- http://ekaw#Individual_Presentation -->

    <owl:Class rdf:about="http://ekaw#Individual_Presentation">
        <rdfs:subClassOf rdf:resource="http://merged#ScientificEvent_WorkingEvent"/>
        <owl:disjointWith rdf:resource="http://merged#Workshop"/>
    </owl:Class>
    


    <!-- http://ekaw#Industrial_Paper -->

    <owl:Class rdf:about="http://ekaw#Industrial_Paper">
        <rdfs:subClassOf rdf:resource="http://merged#Contribution_Paper"/>
        <owl:disjointWith rdf:resource="http://ekaw#Regular_Paper"/>
        <owl:disjointWith rdf:resource="http://ekaw#Workshop_Paper"/>
        <owl:disjointWith rdf:resource="http://merged#PosterPaper"/>
    </owl:Class>
    


    <!-- http://ekaw#Industrial_Session -->

    <owl:Class rdf:about="http://ekaw#Industrial_Session">
        <rdfs:subClassOf rdf:resource="http://ekaw#Conference_Session"/>
    </owl:Class>
    


    <!-- http://ekaw#Invited_Speaker -->

    <owl:Class rdf:about="http://ekaw#Invited_Speaker">
        <rdfs:subClassOf rdf:resource="http://ekaw#Presenter"/>
    </owl:Class>
    


    <!-- http://ekaw#Invited_Talk -->

    <owl:Class rdf:about="http://ekaw#Invited_Talk">
        <rdfs:subClassOf rdf:resource="http://ekaw#Individual_Presentation"/>
        <owl:disjointWith rdf:resource="http://ekaw#Session"/>
        <owl:disjointWith rdf:resource="http://ekaw#Track"/>
        <owl:disjointWith rdf:resource="http://merged#Conference"/>
        <owl:disjointWith rdf:resource="http://merged#SocialEvent"/>
        <owl:disjointWith rdf:resource="http://merged#Tutorial"/>
        <owl:disjointWith rdf:resource="http://merged#Workshop"/>
    </owl:Class>
    


    <!-- http://ekaw#Invited_Talk_Abstract -->

    <owl:Class rdf:about="http://ekaw#Invited_Talk_Abstract">
        <rdfs:subClassOf rdf:resource="http://ekaw#Abstract"/>
    </owl:Class>
    


    <!-- http://ekaw#Late-Registered_Participant -->

    <owl:Class rdf:about="http://ekaw#Late-Registered_Participant">
        <rdfs:subClassOf rdf:resource="http://merged#ConferenceParticipant"/>
