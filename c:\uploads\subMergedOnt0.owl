    <!-- http://www.ebi.ac.uk/efo/swo/SWO_0000380 -->

    <owl:Class rdf:about="http://www.ebi.ac.uk/efo/swo/SWO_0000380">
        <rdfs:label>obsolete_SBML model</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://merged#ObsoleteClass"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <efo:obsoleted_in_version>0.5</efo:obsoleted_in_version>
        <rdfs:comment>&apos;SBML model&apos; was classed as a child of algorithm, when this clearly isn&apos;t the case. As SWO already contained &apos;SBML file&apos; (to cover the data format itself), there was no need for this class at all. The one class (SBMLR) which referenced this class had the relevant axiom deleted. For referencing the SBML format, please use the class &apos;SBML file&apos;.</rdfs:comment>
        <dc:contributor>Marked as obsolete by Allyson Lister.</dc:contributor>
    </owl:Class>
    


